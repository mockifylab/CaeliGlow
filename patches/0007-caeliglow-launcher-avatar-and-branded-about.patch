     m_launcherAvatar->clear(renderer);
     m_launcherAvatar->setVisible(false);
     m_launcherAvatar->setParticipatesInLayout(false);
@@ -2227,6 +2236,13 @@ void LauncherPanel::syncLauncherAvatar(Renderer& renderer) {
     return;
   }
 
+  // A real user avatar takes over from the brand logo.
+  if (m_logoAvatarActive) {
+    m_logoAnim.detach();
+    m_logoAvatarActive = false;
+    m_launcherAvatar->clear(renderer);
+  }
+
   if (displayPath != m_launcherAvatarPath) {
     m_launcherAvatarPath = displayPath;
     m_launcherAvatar->clear(renderer);
@@ -2248,6 +2264,44 @@ void LauncherPanel::syncLauncherAvatar(Renderer& renderer) {
   }
 }
 
+bool LauncherPanel::ensureLogoAvatar(Renderer& renderer) {
+  if (!m_logoAvatarLoaded) {
+    m_logoAvatarLoaded = true;
+    m_logoAvatarUsable =
+        m_logoAnim.load(renderer, caeliglow::AnimatedImage::kIdle, "caeliglow/logo-panel-idle.gif");
+    if (!m_logoAvatarUsable) {
+      return false;
+    }
+  }
+  if (!m_logoAvatarUsable || m_launcherAvatar == nullptr || m_launcherAvatarFallback == nullptr) {
+    return false;
+  }
+  m_logoRenderer = &renderer;
+  m_logoAnim.attach(renderer, m_launcherAvatar);
+  m_launcherAvatar->setVisible(true);
+  m_launcherAvatar->setParticipatesInLayout(true);
+  m_launcherAvatarFallback->setVisible(false);
+  m_launcherAvatarFallback->setParticipatesInLayout(false);
+  m_logoAvatarActive = true;
+  PanelManager::instance().requestFrameTick();
+  return true;
+}
+
+void LauncherPanel::onFrameTick(float deltaMs) {
+  if (!m_logoAvatarActive || m_logoRenderer == nullptr || m_launcherAvatar == nullptr) {
+    return;
+  }
+  if (!m_logoAnim.isAnimating()) {
+    return;
+  }
+  m_logoAnim.advance(*m_logoRenderer, deltaMs);
+  if (root() != nullptr) {
+    root()->markPaintDirty();
+  }
+  PanelManager::instance().requestRedraw();
+  PanelManager::instance().requestFrameTick();
+}
+
 void LauncherPanel::showProviderOverview() {
   const std::string prefix = m_config != nullptr ? m_config->config().shell.launcher.providerPrefix : "/";
   if (!prefix.empty()) {
@@ -2346,6 +2400,11 @@ void LauncherPanel::onClose() {
   if (m_actionsMenu != nullptr && m_actionsMenu->isOpen()) {
     m_actionsMenu->close();
   }
+  // CaeliGlow: stop driving the brand-logo avatar frame loop while the panel is closed.
+  if (m_logoAvatarActive) {
+    m_logoAnim.detach();
+    m_logoAvatarActive = false;
+  }
   if (m_asyncTextures != nullptr) {
     DeferredCall::callLater([asyncTextures = m_asyncTextures]() { asyncTextures->trimUnused(0); });
   }
