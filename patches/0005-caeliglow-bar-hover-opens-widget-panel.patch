+bool Widget::boundHoverPanel(std::string& panelId, std::string& context) {
+  panelId.clear();
+  context.clear();
+  const auto* action = m_gestureBindings.find(noctalia::bar::Gesture::Left);
+  if (action == nullptr || action->kind != noctalia::bar::WidgetAction::Kind::Ipc
+      || !noctalia::bar::isAnchoredPanelVerb(action->verb)) {
+    return false;
+  }
+  const auto args = noctalia::bar::parsePanelVerbArgs(action->args);
+  if (args.panelId.empty()) {
+    return false;
+  }
+  panelId = args.panelId;
+  context = args.panelContext;
+  return true;
+}
+
+std::string Widget::hoverOpenBoundPanel() {
+  std::string panelId;
+  std::string context;
+  if (!boundHoverPanel(panelId, context)) {
+    return {};
+  }
+  // Open (not toggle): hover always reveals; the bar's close-watch owns dismissal.
+  requestPanelToggle(panelId, context, std::nullopt, std::nullopt, Widget::PanelActivation::Open);
+  return panelId;
+}
