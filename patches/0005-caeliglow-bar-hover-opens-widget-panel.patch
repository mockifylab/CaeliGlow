+void Bar::handleWidgetHoverReveal(BarInstance& instance, InputArea* hoveredArea) {
+  if (!kHoverRevealEnabled) {
+    return;
+  }
+  Widget* hovered = widgetFromHoveredArea(instance, hoveredArea);
+
+  // Still parked on the widget whose panel we already revealed: keep it open and stop the timers
+  // (the pointer is exactly where the panel belongs).
+  if (hovered != nullptr && hovered == instance.hoverRevealWidget) {
+    instance.hoverRevealDwellTimer.stop();
+    instance.hoverRevealCloseTimer.stop();
+    return;
+  }
+
+  // Left the revealed widget (or never had one): cancel a dwell that hasn't fired yet, so a fast
+  // sweep across the bar never opens a panel we already moved away from.
+  instance.hoverRevealDwellTimer.stop();
+
+  // If we own a revealed panel, arm the close-watch. It keeps the panel alive while the pointer
+  // dives into it and closes it once the pointer is gone from both the widget and the panel.
+  if (instance.hoverRevealWidget != nullptr) {
+    beginHoverRevealCloseWatch(instance);
+  }
+
+  std::string panelId;
+  std::string context;
+  if (hovered == nullptr || !hovered->boundHoverPanel(panelId, context)) {
+    return;
+  }
+
+  // Dwell before opening. When it fires, hover has not changed since scheduling (any change
+  // cancels this timer above), so the pointer is confirmed to still be on this widget.
+  Widget* target = hovered;
+  instance.hoverRevealDwellTimer.start(kHoverRevealDwell, [this, &instance, target]() {
+    const std::string opened = target->hoverOpenBoundPanel();
+    if (opened.empty()) {
+      return;
+    }
+    instance.hoverRevealWidget = target;
+    instance.hoverRevealPanelId = opened;
+    beginHoverRevealCloseWatch(instance);
+  });
+}
+
+void Bar::beginHoverRevealCloseWatch(BarInstance& instance) {
+  if (instance.hoverRevealPanelId.empty()) {
+    return;
+  }
+  instance.hoverRevealCloseTimer.startRepeating(kHoverRevealCloseWatch, [this, &instance]() {
+    auto& pm = PanelManager::instance();
+    const std::string owned = instance.hoverRevealPanelId;
+    if (owned.empty() || !pm.isOpenPanel(owned)) {
+      // Our panel was closed or replaced by something else (click, edge trigger, another hover).
+      // Relinquish quietly; we only ever dismiss panels we opened ourselves.
+      clearHoverReveal(instance, /*closePanel=*/false);
+      return;
+    }
+    const bool pointerOnPanel = pm.isPointerInsidePanel();
+    const bool pointerOnWidget = instance.hoverRevealWidget != nullptr
+        && instance.hoverRevealWidget == instance.hoverHighlightWidget;
+    if (pointerOnPanel || pointerOnWidget) {
+      return; // keep open, re-check on the next tick
+    }
+    clearHoverReveal(instance, /*closePanel=*/true);
+  });
+}
+
+void Bar::clearHoverReveal(BarInstance& instance, bool closePanel) {
+  instance.hoverRevealDwellTimer.stop();
+  instance.hoverRevealCloseTimer.stop();
+  const std::string owned = instance.hoverRevealPanelId;
+  instance.hoverRevealWidget = nullptr;
+  instance.hoverRevealPanelId.clear();
+  if (closePanel && !owned.empty()) {
+    auto& pm = PanelManager::instance();
+    if (pm.isOpenPanel(owned)) {
+      pm.closePanel(/*animateClose=*/true);
+    }
+  }
+}
