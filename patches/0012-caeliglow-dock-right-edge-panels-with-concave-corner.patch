+  // CaeliGlow: edge-flush dock for detached panels (the right-edge power pill).
+  // Overrides the generic placement: the body sits at the absolute screen edge,
+  // the docked side drops its shadow bleed (there is no room off-screen), and the
+  // surface grows by a corner flare on the cross axis so the concave screen-edge
+  // corners have room to render — the compositor clips the flare's outer half,
+  // which reads as the panel melting into the screen edge.
+  const std::string dockEdge = m_activePanel->dockToScreenEdge();
+  const bool useDockedPlacement = !useAttachedPlacement && !dockEdge.empty() && outputWidth > 0 && outputHeight > 0
+      && (dockEdge == "left" || dockEdge == "right" || dockEdge == "top" || dockEdge == "bottom");
+  std::int32_t dockInsetX = detachedShadowBleed.left;
+  std::int32_t dockInsetY = detachedShadowBleed.up;
+  std::int32_t dockBleedRight = static_cast<std::int32_t>(detachedShadowBleed.right);
+  std::int32_t dockBleedBottom = static_cast<std::int32_t>(detachedShadowBleed.down);
+  std::optional<AttachedRevealDirection> dockRevealDirection;
+  if (useDockedPlacement) {
+    const float dockRadius = Style::scaledRadiusXl(m_activePanel->contentScale());
+    const std::int32_t flare = static_cast<std::int32_t>(std::ceil(dockRadius)) + 2;
+    const auto bodyW = static_cast<std::int32_t>(panelWidth);
+    const auto bodyH = static_cast<std::int32_t>(panelHeight);
+    const auto bleedL = static_cast<std::int32_t>(detachedShadowBleed.left);
+    const auto bleedR = static_cast<std::int32_t>(detachedShadowBleed.right);
+    const auto bleedU = static_cast<std::int32_t>(detachedShadowBleed.up);
+    const auto bleedD = static_cast<std::int32_t>(detachedShadowBleed.down);
+    standaloneAnchor = 0;
+    standaloneMarginTop = standaloneMarginRight = standaloneMarginBottom = standaloneMarginLeft = 0;
+    if (dockEdge == "right" || dockEdge == "left") {
+      const std::int32_t surfaceW = bodyW + bleedL + bleedR;
+      const std::int32_t surfaceH = bodyH + bleedU + bleedD + 2 * flare;
+      requestedSurfaceWidth = static_cast<std::uint32_t>(surfaceW - (dockEdge == "right" ? bleedR : bleedL));
+      requestedSurfaceHeight = static_cast<std::uint32_t>(surfaceH);
+      standaloneAnchor = LayerShellAnchor::Top | (dockEdge == "right" ? LayerShellAnchor::Right : LayerShellAnchor::Left);
+      standaloneMarginTop = std::max(0, (outputHeight - surfaceH) / 2);
+      dockInsetY = bleedU + flare;
+      if (dockEdge == "right") {
+        dockBleedRight = 0;
+      } else {
+        dockInsetX = 0;
+      }
+    } else {
+      const std::int32_t surfaceW = bodyW + bleedL + bleedR + 2 * flare;
+      const std::int32_t surfaceH = bodyH + bleedU + bleedD;
+      requestedSurfaceWidth = static_cast<std::uint32_t>(surfaceW);
+      requestedSurfaceHeight = static_cast<std::uint32_t>(surfaceH - (dockEdge == "bottom" ? bleedD : bleedU));
+      standaloneAnchor = (dockEdge == "bottom" ? LayerShellAnchor::Bottom : LayerShellAnchor::Top) | LayerShellAnchor::Left;
+      standaloneMarginLeft = std::max(0, (outputWidth - surfaceW) / 2);
+      dockInsetX = bleedL + flare;
+      if (dockEdge == "bottom") {
+        dockBleedBottom = 0;
+      } else {
+        dockInsetY = 0;
+      }
+    }
+    fallbackSurfaceWidth = requestedSurfaceWidth;
+    fallbackSurfaceHeight = requestedSurfaceHeight;
+    detachedPanelInputRect = panelInputRectForSurface(
+        standaloneAnchor, standaloneMarginTop, standaloneMarginRight, standaloneMarginBottom, standaloneMarginLeft,
+        outputWidth, outputHeight, requestedSurfaceWidth, requestedSurfaceHeight, dockInsetX, dockInsetY, panelWidth,
+        panelHeight
+    );
+    dockRevealDirection = attached_panel::revealDirection(dockEdge);
+  }
