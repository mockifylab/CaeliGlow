+
+// CaeliGlow: resolve the configured motion language for panel reveals.
+PanelManager::PanelMotion PanelManager::panelMotion() const {
+  PanelMotion motion;
+  if (m_config == nullptr) {
+    return motion;
+  }
+  const auto& cg = m_config->config().caeliglow;
+  using Motion = CaeliGlowConfig::Motion;
+  const float e = std::clamp(cg.elasticity, 0.0F, 1.0F);
+  motion.openMs = std::max(80, cg.durationMs);
+  motion.closeMs = std::max(80, static_cast<std::int32_t>(static_cast<float>(motion.openMs) * 0.6F));
+  switch (cg.motion) {
+  case Motion::Classic:
+    break; // upstream cubic reveal, unchanged
+  case Motion::Soft:
+    motion.openEasing = Easing::EaseOutBack;
+    motion.closeEasingAttached = Easing::EaseInOutQuad;
+    motion.closeEasingDetached = Easing::EaseInOutQuad;
+    break;
+  case Motion::Fizzy:
+    motion.openEasing = Easing::EaseOutElastic;
+    motion.closeEasingAttached = Easing::EaseOutBack;
+    motion.closeEasingDetached = Easing::EaseOutBack;
+    motion.squash = 0.05F + 0.07F * e;
+    break;
+  case Motion::Morphy:
+    motion.openEasing = Easing::EaseOutElastic;
+    motion.closeEasingAttached = Easing::EaseOutBack;
+    motion.closeEasingDetached = Easing::EaseOutBack;
+    motion.squash = 0.10F + 0.14F * e;
+    break;
+  }
+  return motion;
+}
+
+// CaeliGlow: "morphy" jelly — the revealed content starts squashed against the edge
+// it grows from and springs through resting size into place, with the axis pair
+// kept area-conserving (scaleY = 2 - scaleX) for the squash-and-stretch feel.
+void PanelManager::startOpenSquashPulse(
+    Node* contentNode, const void* ownerNode, const PanelMotion& motion, AttachedRevealDirection direction
+) {
+  if (contentNode == nullptr || ownerNode == nullptr || motion.squash <= 0.0F) {
+    return;
+  }
+  const float w = contentNode->width();
+  const float h = contentNode->height();
+  float originX = w * 0.5F;
+  float originY = 0.0F;
+  switch (direction) {
+  case AttachedRevealDirection::Up: // grows off a bottom bar: anchored at the bottom
+    originY = h;
+    break;
+  case AttachedRevealDirection::Down:
+    originY = 0.0F;
+    break;
+  case AttachedRevealDirection::Left: // grows off a right edge: anchored at the right
+    originX = w;
+    originY = h * 0.5F;
+    break;
+  case AttachedRevealDirection::Right:
+    originX = 0.0F;
+    originY = h * 0.5F;
+    break;
+  }
+  contentNode->setTransformOrigin(originX, originY);
+  m_animations.animate(
+      1.0F - motion.squash, 1.0F, motion.openMs, Easing::EaseOutElastic,
+      [contentNode](float v) { contentNode->setScale(v, 2.0F - v); }, {}, ownerNode
+  );
 }
 
