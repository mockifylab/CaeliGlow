diff --git a/tests/update_model_test.cpp b/tests/update_model_test.cpp
new file mode 100644
index 000000000..7dddd3664
--- /dev/null
+++ b/tests/update_model_test.cpp
@@ -0,0 +1,131 @@
+// CaeliGlow: unit tests for the pure update decision logic and the no-terminal
+// installer progress parser in caeliglow/update_model.hpp. Both are side-effect
+// free, so they are exercised against captured GitHub JSON and installer logs
+// without any network or process access.
+#include "caeliglow/update_model.hpp"
+#include "tests/test_check.h"
+
+#include <cmath>
+#include <string>
+
+namespace {
+
+  bool nearlyEqual(float lhs, float rhs, float eps = 1e-3F) { return std::fabs(lhs - rhs) < eps; }
+
+  // A GitHub "/releases" array with one entry, for driving evaluate().
+  std::string oneRelease(const std::string& tag, bool prerelease = false, const std::string& body = "notes") {
+    return std::string(R"([{"tag_name":")")
+        + tag
+        + R"(","name":")"
+        + tag
+        + R"(","body":")"
+        + body
+        + R"(","prerelease":)"
+        + (prerelease ? "true" : "false")
+        + "}]";
+  }
+
+  void testEvaluate() {
+    // Up to date: installed equals the newest stable release.
+    {
+      const auto r = caeliglow::evaluate("1.6.0", 200, oneRelease("v1.6.0"));
+      TEST_CHECK(r.state == caeliglow::UpdateState::UpToDate);
+    }
+    // Update available: a newer stable release exists.
+    {
+      const auto r = caeliglow::evaluate("1.6.0", 200, oneRelease("v1.6.1"));
+      TEST_CHECK(r.state == caeliglow::UpdateState::UpdateAvailable);
+      TEST_CHECK(r.latestVersion == "v1.6.1");
+      TEST_CHECK(!r.notes.empty());
+    }
+    // Highest wins when several are listed out of order.
+    {
+      const std::string body = R"([{"tag_name":"v1.5.0"},{"tag_name":"v1.7.2"},{"tag_name":"v1.6.1"}])";
+      const auto r = caeliglow::evaluate("1.6.0", 200, body);
+      TEST_CHECK(r.state == caeliglow::UpdateState::UpdateAvailable);
+      TEST_CHECK(r.latestVersion == "v1.7.2");
+    }
+    // Prereleases are ignored on the stable channel.
+    {
+      const auto r = caeliglow::evaluate("1.6.0", 200, oneRelease("v9.9.9", /*prerelease=*/true));
+      TEST_CHECK(r.state == caeliglow::UpdateState::NoReleases);
+    }
+    // Transport failure / rate limit / server error / malformed body.
+    TEST_CHECK(caeliglow::evaluate("1.6.0", 0, "").state == caeliglow::UpdateState::Offline);
+    TEST_CHECK(caeliglow::evaluate("1.6.0", 403, "").state == caeliglow::UpdateState::RateLimited);
+    TEST_CHECK(caeliglow::evaluate("1.6.0", 429, "").state == caeliglow::UpdateState::RateLimited);
+    TEST_CHECK(caeliglow::evaluate("1.6.0", 500, "").state == caeliglow::UpdateState::Error);
+    TEST_CHECK(caeliglow::evaluate("1.6.0", 200, "not json").state == caeliglow::UpdateState::Error);
+    // An invalid installed version is surfaced as an error rather than compared.
+    TEST_CHECK(caeliglow::evaluate("garbage", 200, oneRelease("v1.6.1")).state == caeliglow::UpdateState::Error);
+  }
+
+  void testParseInstallProgress() {
+    // Empty log: a small positive fraction so the bar is visibly alive.
+    {
+      const auto p = caeliglow::parseInstallProgress("");
+      TEST_CHECK(p.fraction > 0.0F);
+      TEST_CHECK(!p.done);
+      TEST_CHECK(!p.failed);
+    }
+    // Git download advances the fraction inside the download band (0.05-0.35).
+    {
+      const auto p = caeliglow::parseInstallProgress("Receiving objects:  50% (50/100)\n");
+      TEST_CHECK(p.fraction > 0.05F);
+      TEST_CHECK(p.fraction < 0.35F);
+      TEST_CHECK(p.phase.find("Downloading") != std::string::npos);
+    }
+    // Build progress maps ninja [n/m] into the build band (0.36-0.85).
+    {
+      const auto p = caeliglow::parseInstallProgress(">> Building CaeliGlow\n[150/300] Compiling\n");
+      // 150/300 lands near the middle of the build band; assert a safe range.
+      TEST_CHECK(p.fraction > 0.55F);
+      TEST_CHECK(p.fraction < 0.70F);
+      TEST_CHECK(p.phase.find("Building") != std::string::npos);
+    }
+    // Progress never regresses across stages.
+    {
+      const std::string log = "Receiving objects: 100% (100/100)\n"
+                              ">> Building CaeliGlow\n"
+                              "[300/300] Linking\n"
+                              ">> Installing into /usr/local\n";
+      const auto p = caeliglow::parseInstallProgress(log);
+      TEST_CHECK(p.fraction >= 0.87F);
+      TEST_CHECK(p.phase.find("Installing") != std::string::npos);
+    }
+    // Shell restart marker approaches completion but is not yet done.
+    {
+      const auto p = caeliglow::parseInstallProgress("Restarting the running CaeliGlow shell\n");
+      TEST_CHECK(p.fraction >= 0.95F);
+      TEST_CHECK(!p.done);
+    }
+    // Success sentinel: done, not failed, full bar.
+    {
+      const std::string log = "[300/300] Linking\nCAELIGLOW_UPDATE_EXIT=0\n";
+      const auto p = caeliglow::parseInstallProgress(log);
+      TEST_CHECK(p.done);
+      TEST_CHECK(!p.failed);
+      TEST_CHECK(nearlyEqual(p.fraction, 1.0F));
+    }
+    // Failure sentinel: done and failed, with the captured error line.
+    {
+      const std::string log = "error: something broke\nCAELIGLOW_UPDATE_EXIT=1\n";
+      const auto p = caeliglow::parseInstallProgress(log);
+      TEST_CHECK(p.done);
+      TEST_CHECK(p.failed);
+      TEST_CHECK(p.error.find("error:") != std::string::npos);
+    }
+    // Carriage-return progress lines are tolerated.
+    {
+      const auto p = caeliglow::parseInstallProgress("Receiving objects: 100% (100/100)\r\n");
+      TEST_CHECK(p.fraction > 0.30F);
+    }
+  }
+
+} // namespace
+
+int main() {
+  testEvaluate();
+  testParseInstallProgress();
+  return 0;
+}
