+// CaeliGlow: installing an update runs the same quick-install one-liner that first
+// installed CaeliGlow, but FULLY DETACHED and with no terminal window. Its output is
+// redirected to a log file the About page polls to drive a live progress bar, and the
+// script's final step restarts the running shell into the new version. Detached
+// (double-fork + setsid) is essential: the installer kills this very shell to relaunch
+// it, so a child of the shell would be taken down mid-restart. Settings and state in
+// ~/.config/caeliglow and the state/cache dirs are never touched.
 void SettingsWindow::installUpdate() {
-  static const std::string kInstaller = "curl -fsSL https://raw.githubusercontent.com/"
+  if (m_installRunning) {
+    return; // an install is already in progress
+  }
+
+  const std::string logPath = FileUtils::expandUserPath("~/.cache/caeliglow/update.log").string();
+  const std::string installerUrl = "https://raw.githubusercontent.com/"
       + std::string(caeliglow::kRepoOwner)
       + "/"
       + std::string(caeliglow::kRepoName)
-      + "/main/scripts/quick-install.sh | bash";
-
-  if (terminal_launch::launch(kInstaller)) {
-    m_aboutStatusText = "Installer terminal launched for v"
-        + (m_aboutUpdateVersion.empty() ? std::string("latest") : m_aboutUpdateVersion)
-        + ". CaeliGlow is replaced in place; your settings and state are kept.";
-    m_aboutUpdateError = false;
-    m_aboutUpdateAvailable = false; // one-shot: the button is gone once the installer runs
-  } else {
-    m_aboutStatusText = "Could not open a terminal to run the installer. Run the quick-install command manually.";
+      + "/main/scripts/quick-install.sh";
+
+  // Truncate the log, run the installer capturing all output to it, then append the
+  // exit-code sentinel the poller watches for completion.
+  const std::string command = "mkdir -p \"$HOME/.cache/caeliglow\"; : > '"
+      + logPath
+      + "'; "
+        "{ curl -fsSL '"
+      + installerUrl
+      + "' | bash; echo \"CAELIGLOW_UPDATE_EXIT=$?\"; } "
+        ">> '"
+      + logPath
+      + "' 2>&1";
+
+  if (!process::runAsync(command)) {
+    m_aboutStatusText = "Could not start the updater. Run the quick-install command manually.";
     m_aboutUpdateError = true;
+    requestContentRebuild();
+    return;
   }
+
+  m_installRunning = true;
+  m_installDone = false;
+  m_installFailed = false;
+  m_installFraction = 0.0F;
+  m_installPhase = "Starting update\u2026";
+  m_installError.clear();
   requestContentRebuild();
+  startInstallPoll();
+}
+
+// CaeliGlow: poll the detached installer's log on the main loop until it reports the
+// exit sentinel (~250 ms is well below the seconds-long build, so the bar stays live).
+void SettingsWindow::startInstallPoll() {
+  m_installTimer.startRepeating(std::chrono::milliseconds(250), [this]() { pollInstallProgress(); });
+}
+
+void SettingsWindow::pollInstallProgress() {
+  const std::string logPath = FileUtils::expandUserPath("~/.cache/caeliglow/update.log").string();
+
+  std::string contents;
+  if (std::ifstream file(logPath); file) {
+    std::ostringstream buffer;
+    buffer << file.rdbuf();
+    contents = buffer.str();
+  }
+
+  const caeliglow::InstallProgress progress = caeliglow::parseInstallProgress(contents);
+
+  m_installFraction = progress.fraction;
+  m_installPhase = progress.phase;
+  if (progress.done && progress.failed && m_installError.empty()) {
+    m_installError = progress.error.empty() ? "The installer reported a failure." : progress.error;
+  }
+
+  // Drive the live nodes directly (they are null when About is not currently shown,
+  // but the state above is kept so the next rebuild renders the correct value).
+  if (m_installBar != nullptr) {
+    m_installBar->setProgress(progress.fraction);
+  }
+  if (m_installPhaseLabel != nullptr) {
+    m_installPhaseLabel->setText(m_installPhase);
+  }
+
+  if (progress.done) {
+    m_installTimer.stop();
+    m_installRunning = false;
+    m_installDone = true;
+    m_installFailed = progress.failed;
+    if (progress.failed) {
+      m_aboutStatusText = "Update failed: " + m_installError;
+      m_aboutUpdateError = true;
+      m_aboutUpdateAvailable = true; // keep the button so the user can retry
+    } else {
+      m_aboutStatusText = "Update applied \u2014 CaeliGlow is restarting into the new version.";
+      m_aboutUpdateError = false;
+      m_aboutUpdateAvailable = false;
+    }
+    requestContentRebuild();
+  }
 }
 
