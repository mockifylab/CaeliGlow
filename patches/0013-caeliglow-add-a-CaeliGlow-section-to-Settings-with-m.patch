+++ b/assets/translations/en.json
@@ -1419,11 +1419,12 @@
         "window-switcher": "Window Switcher"
       },
       "sections": {
-        "about": "CaeliGlow",
+        "about": "About",
         "accessibility": "Accessibility",
         "appearance": "Appearance",
         "backdrop": "Backdrop",
         "bar": "Bar",
+        "caeliglow": "CaeliGlow",
         "calendar": "Calendar",
         "control-center": "Control Center",
         "desktop": "Desktop",
@@ -1684,6 +1685,18 @@
           "imperial": "Imperial",
           "metric": "Metric"
         }
+      },
+      "caeliglow": {
+        "motion": {
+          "classic": "Classic",
+          "soft": "Soft",
+          "fizzy": "Fizzy",
+          "morphy": "Morphy"
+        },
+        "power-edge": {
+          "left": "Left",
