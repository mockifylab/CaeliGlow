+  // CaeliGlow reads ~/.config/caeliglow (its own namespace since v1.4.0) and never rewrites the
+  // older ~/.config/noctalia one. If a user still has the legacy directory but no [brightness]
+  // config for CaeliGlow, their brightness settings silently stopped applying - warn once,
+  // read-only: the old namespace is neither imported nor touched.
+  void warnAboutUnmigratedNoctaliaConfig(NotificationManager& notifications) {
+    try {
+      const std::filesystem::path caeliglowDir{FileUtils::configDir()};
+
+      std::filesystem::path legacyDir;
+      if (const char* xdg = std::getenv("XDG_CONFIG_HOME"); xdg != nullptr && xdg[0] != '\0') {
+        legacyDir = std::string(xdg) + "/noctalia";
+      } else if (const char* home = std::getenv("HOME"); home != nullptr && home[0] != '\0') {
+        legacyDir = std::string(home) + "/.config/noctalia";
+      } else {
+        return;
+      }
+
+      if (!std::filesystem::is_directory(legacyDir)) {
+        return;
+      }
+
+      bool brightnessConfigured = false;
+      if (std::filesystem::is_directory(caeliglowDir)) {
+        for (const auto& entry : std::filesystem::directory_iterator(caeliglowDir)) {
+          const auto path = entry.path();
+          if (!entry.is_regular_file() || path.extension() != ".toml") {
+            continue;
+          }
+          std::ifstream file{path};
+          std::string line;
+          while (std::getline(file, line)) {
+            if (line.rfind("[brightness]", 0) == 0U || line.rfind("[brightness.", 0) == 0U) {
+              brightnessConfigured = true;
+              break;
+            }
+          }
+          if (brightnessConfigured) {
+            break;
+          }
+        }
+      }
+      if (brightnessConfigured) {
+        return;
+      }
+
+      kLog.warn(
+          "legacy {} exists but {} has no [brightness] config; older settings were not migrated", legacyDir.string(),
+          caeliglowDir.string()
+      );
+      notifications.addInternal(
+          "CaeliGlow", "Brightness settings were not migrated",
+          "CaeliGlow reads "
+              + caeliglowDir.string()
+              + " and found no [brightness] config there. The older "
+              + legacyDir.string()
+              + " directory is ignored and was left untouched - copy your [brightness] "
+                "section over if you still need it.",
+          Urgency::Normal
+      );
+    } catch (const std::exception& e) {
+      kLog.warn("settings migration warning skipped: {}", e.what());
+    }
+  }
+
