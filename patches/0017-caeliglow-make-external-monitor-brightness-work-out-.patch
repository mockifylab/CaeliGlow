+  // Tri-state enablement: unset means auto - discover DDC/CI whenever a connector has no
+  // kernel backlight; an explicit brightness.enable_ddcutil overrides in both directions.
+  [[nodiscard]] bool ddcDiscoveryEnabled() const { return activeConfig.enableDdcutil.value_or(true); }
+
+  [[nodiscard]] std::string ddcEnablementLabel() const {
+    if (!activeConfig.enableDdcutil.has_value()) {
+      return "auto";
+    }
+    return *activeConfig.enableDdcutil ? "true (explicitly enabled)" : "false (explicitly disabled)";
+  }
+
+  [[nodiscard]] std::string discoverySummary() const {
+    auto join = []<typename Range>(const Range& values) {
+      std::string joined;
+      for (const auto& value : values) {
+        if (!joined.empty()) {
+          joined += ", ";
+        }
+        joined += value;
+      }
+      return joined;
+    };
+
+    std::string out;
+    const std::vector<std::string> sysfsDevices = listSysfsBacklightDevices();
+    out += "sysfs backlight devices: " + (sysfsDevices.empty() ? std::string("none") : join(sysfsDevices)) + "\n";
+    out += "enable_ddcutil: " + ddcEnablementLabel() + "\n";
+    out += std::string("ddcutil command: ") + (process::commandExists("ddcutil") ? "installed" : "missing") + "\n";
+
+    const auto candidates = ddcConnectors();
+    out += "ddc candidates (connectors without a kernel backlight): "
+        + (candidates.empty() ? std::string("none") : join(candidates))
+        + "\n";
+
+    if (internals.empty()) {
+      out += "discovered controls: none\n";
+      return out;
+    }
+    for (const auto& display : internals) {
+      out += "discovered control: " + display.connectorName + " ";
+      if (display.backend == RuntimeBackend::Ddcutil) {
+        out += "via ddcutil bus " + std::to_string(display.ddcBus);
+      } else {
+        out += "via sysfs backlight " + display.backlightName;
+      }
+      if (display.quarantined) {
+        out += " (quarantined after repeated failures)";
+      }
+      out += "\n";
+    }
+    return out;
+  }
+
+  std::string rescanReport() {
