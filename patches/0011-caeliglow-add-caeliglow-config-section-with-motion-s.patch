diff --git a/src/render/animation/animation.cpp b/src/render/animation/animation.cpp
index f94e44b8c..e601b6b1b 100644
--- a/src/render/animation/animation.cpp
+++ b/src/render/animation/animation.cpp
@@ -1,6 +1,7 @@
 #include "render/animation/animation.h"
 
 #include <algorithm>
+#include <cmath>
 
 float applyEasing(Easing easing, float t) {
   t = std::clamp(t, 0.0F, 1.0F);
@@ -40,6 +41,19 @@ float applyEasing(Easing easing, float t) {
     const float f = t - 1.0F;
     return 1.0F + c3 * f * f * f + c1 * f * f;
   }
+
+  case Easing::EaseOutElastic: {
+    // CaeliGlow: damped sine spring — the value crosses its target several times
+    // with decaying amplitude (classic easeOutElastic, period 0.3s).
+    if (t <= 0.0F) {
+      return 0.0F;
+    }
+    if (t >= 1.0F) {
+      return 1.0F;
+    }
+    constexpr float c4 = 2.0943951F; // 2*pi/3
+    return std::pow(2.0F, -10.0F * t) * std::sin((t * 10.0F - 0.75F) * c4) + 1.0F;
+  }
   }
 
   return t;
diff --git a/src/render/animation/animation.h b/src/render/animation/animation.h
index 5512c5ad0..b8321a64f 100644
--- a/src/render/animation/animation.h
+++ b/src/render/animation/animation.h
@@ -12,6 +12,8 @@ enum class Easing : std::uint8_t {
   EaseOutCubic,
   EaseInOutCubic,
   EaseOutBack,
+  // CaeliGlow: damped-sine spring overshoot ("fizzy"/"morphy" motion).
+  EaseOutElastic,
 };
 
 float applyEasing(Easing easing, float t);
