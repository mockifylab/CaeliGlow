 src/render/animation/animation.h       |  2 ++
 src/shell/bar/bar.cpp                  |  4 +++-
 tests/config_schema_roundtrip_test.cpp |  7 ++++++
 10 files changed, 77 insertions(+), 1 deletion(-)

