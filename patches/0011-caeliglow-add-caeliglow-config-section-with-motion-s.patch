diff --git a/src/config/config_types.h b/src/config/config_types.h
index 7b1505065..0282e6305 100644
--- a/src/config/config_types.h
+++ b/src/config/config_types.h
@@ -1926,6 +1926,35 @@ struct HotCornersConfig {
   bool operator==(const HotCornersConfig&) const = default;
 };
 
+// CaeliGlow: [caeliglow] — the behavior and motion of CaeliGlow's signature layer.
+// Everything CaeliGlow adds on top of the base shell is controlled here (and from
+// the CaeliGlow section in Settings), with theme-aware UI like the other sections.
+struct CaeliGlowConfig {
+  // Panel open/close motion language:
+  //  classic — the base shell's smooth cubic slide.
+  //  soft    — one gentle overshoot that settles back (back easing).
+  //  fizzy   — bubbly multi-bounce spring (elastic easing).
+  //  morphy  — elastic spring plus a squash-and-stretch shape pulse.
+  enum class Motion : std::uint8_t { Classic = 0, Soft = 1, Fizzy = 2, Morphy = 3 };
+  Motion motion = Motion::Fizzy;
+  // Open animation length in ms; closes reuse 60% of it (floor 80 ms).
+  std::int32_t durationMs = 420;
+  // Overshoot strength 0..1: how far the spring flies past its resting shape.
+  float elasticity = 0.55F;
+  // Hovering a bar widget opens its panel (short dwell); the panel closes when
+  // the pointer leaves both the widget and the panel.
+  bool hoverOpen = true;
+
+  bool operator==(const CaeliGlowConfig&) const = default;
+};
+
+constexpr EnumOption<CaeliGlowConfig::Motion> kCaeliGlowMotions[] = {
+    {CaeliGlowConfig::Motion::Classic, "classic", "settings.options.caeliglow.motion.classic"},
+    {CaeliGlowConfig::Motion::Soft, "soft", "settings.options.caeliglow.motion.soft"},
+    {CaeliGlowConfig::Motion::Fizzy, "fizzy", "settings.options.caeliglow.motion.fizzy"},
+    {CaeliGlowConfig::Motion::Morphy, "morphy", "settings.options.caeliglow.motion.morphy"},
+};
+
 struct Config {
   std::vector<BarConfig> bars;
   std::unordered_map<std::string, WidgetConfig> widgets;
@@ -1936,6 +1965,7 @@ struct Config {
   DockConfig dock;
   DesktopWidgetsConfig desktopWidgets;
   HotCornersConfig hotCorners;
+  CaeliGlowConfig caeliglow;
   StorageConfig storage;
   ShellConfig shell;
   OsdConfig osd;
@@ -1986,6 +2016,7 @@ struct ConfigChangeSet {
   bool controlCenter = true;
   bool plugins = true;
   bool hotCorners = true;
+  bool caeliglow = true; // CaeliGlow: [caeliglow] section changed
   bool storage = true;
   bool accessibility = true;
 
@@ -2016,6 +2047,7 @@ struct ConfigChangeSet {
         || controlCenter
         || plugins
         || hotCorners
+        || caeliglow
         || storage
         || accessibility;
   }
diff --git a/src/config/schema/config_schema.cpp b/src/config/schema/config_schema.cpp
