--- a/src/config/schema/config_schema.cpp
+++ b/src/config/schema/config_schema.cpp
@@ -473,6 +473,18 @@ namespace noctalia::config::schema {
     return s;
   }
 
+  // CaeliGlow: [caeliglow] — motion language, timing, and hover behavior of the
+  // signature layer. Ranges double as the Settings sliders' bounds.
+  const Schema<CaeliGlowConfig>& caeliglowSchema() {
+    static const Schema<CaeliGlowConfig> s = {
+        enumField(&CaeliGlowConfig::motion, "motion", kCaeliGlowMotions),
+        field(&CaeliGlowConfig::durationMs, "duration_ms", Range<std::int64_t>{80, 1500}),
+        field(&CaeliGlowConfig::elasticity, "elasticity", Range<float>{0.0F, 1.0F}),
+        field(&CaeliGlowConfig::hoverOpen, "hover_open"),
+    };
+    return s;
+  }
+
   namespace {
     const Schema<BrightnessMonitorOverride>& brightnessMonitorSchema() {
       static const Schema<BrightnessMonitorOverride> s = {
