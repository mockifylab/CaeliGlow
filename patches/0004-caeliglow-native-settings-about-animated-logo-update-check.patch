diff --git a/src/shell/settings/settings_content_about.cpp b/src/shell/settings/settings_content_about.cpp
new file mode 100644
index 000000000..400e603bb
--- /dev/null
+++ b/src/shell/settings/settings_content_about.cpp
@@ -0,0 +1,255 @@
+// CaeliGlow — native Settings "About" section + live update check.
+//
+// The section shows the baked-in CaeliGlow version, the base Noctalia release, and
+// license/attribution, plus a "Check for updates" button. The button issues a single
+// unauthenticated GET to GitHub's public releases endpoint (via Noctalia's own async
+// HttpClient, whose callback is guaranteed to run on the main loop) and renders the
+// result with the already-unit-tested decision logic in caeliglow/update_model.hpp.
+// Release notes are never fetched/executed; only a short plain-text status is shown.
+#include "shell/settings/settings_content_about.h"
+
+#include "caeliglow/meta.hpp"
+#include "caeliglow/update_model.hpp"
+#include "caeliglow/version.hpp"
+#include "config/config_service.h"
+#include "core/files/resource_paths.h"
+#include "core/log.h"
+#include "net/http_client.h"
+#include "render/core/image_decoder.h"
+#include "render/core/renderer.h"
+#include "render/core/texture_manager.h"
+#include "shell/settings/settings_content_common.h"
+#include "shell/settings/settings_window.h"
+#include "ui/builders.h"
+#include "ui/controls/flex.h"
+#include "ui/controls/image.h"
+#include "ui/palette.h"
+#include "ui/style.h"
+#include "util/file_utils.h"
+
+#include <chrono>
+#include <cstddef>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace {
+  constexpr Logger kAboutLog("caeliglow");
+  // Bundled animated crescent-moon mark, installed with the asset tree.
+  constexpr const char* kLogoAsset = "caeliglow/logo-animated.gif";
+  // Resource caps for the resident decoded animation (well within budget: ~2 MB).
+  constexpr int kMaxLogoFrames = 128;
+  constexpr std::size_t kMaxLogoBytes = 16ULL * 1024 * 1024;
+} // namespace
+
+namespace settings {
+  namespace {
+    std::unique_ptr<Label>
+    label(std::string_view text, float size, ColorRole role, FontWeight weight = FontWeight::Normal) {
+      return makeLabel(text, size, colorSpecFromRole(role), weight);
+    }
+  } // namespace
+
+  void addSettingsCaeliGlowAbout(Flex& content, SettingsAboutContext ctx) {
+    if (ctx.selectedSection != "about") {
+      return;
+    }
+    const float scale = ctx.scale;
+
+    auto sectionCol = ui::column({
+        .align = FlexAlign::Stretch,
+        .gap = Style::spaceSm * scale,
+        .padding = Style::spaceLg * scale,
+        .fill = clearColorSpec(),
+        .fillWidth = true,
+    });
+    Flex* section = sectionCol.get();
+    content.addChild(std::move(sectionCol));
+
+    auto titleRow = ui::row(
+        {.align = FlexAlign::Center, .gap = Style::spaceSm * scale, .fillWidth = true},
+        label("CaeliGlow", Style::fontSizeHeader * scale, ColorRole::Primary, FontWeight::Bold)
+    );
+    // Animated crescent-moon mark to the left of the title. The node is created empty;
+    // SettingsWindow decodes the GIF and drives its frames (see attachAboutLogo).
+    Image* logoImage = nullptr;
+    const float logoSize = Style::fontSizeHeader * scale * 1.7F;
+    auto logo = ui::image({
+        .out = &logoImage,
+        .fit = ImageFit::Contain,
+        .width = logoSize,
+        .height = logoSize,
+    });
+    titleRow->insertChildAt(0, std::move(logo));
+    if (ctx.logoOut != nullptr) {
+      *ctx.logoOut = logoImage;
+    }
+    if (ctx.pageTitleRow != nullptr && ctx.pageTitleRow->children().empty()) {
+      ctx.pageTitleRow->addChild(std::move(titleRow));
+    } else {
+      section->addChild(std::move(titleRow));
+    }
+
+    // Identity block.
+    section->addChild(label("Version " + ctx.installedVersion, Style::fontSizeBody * scale, ColorRole::OnSurface));
+    section->addChild(label(
+        "Built on Noctalia " + ctx.noctaliaBaseVersion, Style::fontSizeCaption * scale, ColorRole::OnSurfaceVariant
+    ));
+    section->addChild(label(
+        "Independent project, MIT licensed. Noctalia (MIT) attribution preserved; "
+        "no Caelestia code or assets used.",
+        Style::fontSizeCaption * scale, ColorRole::OnSurfaceVariant
+    ));
+
+    section->addChild(ui::separator({}));
+
+    // Update check.
+    const bool canCheck = !ctx.offlineMode && !ctx.updateInFlight && static_cast<bool>(ctx.onCheckForUpdates);
+    section->addChild(
+        ui::button({
+            .text = ctx.updateInFlight ? std::string("Checking\u2026") : std::string("Check for updates"),
+            .enabled = canCheck,
+            .variant = ButtonVariant::Primary,
+            .radius = Style::scaledRadiusMd(scale),
+            .onClick = ctx.onCheckForUpdates,
+        })
+    );
+
+    if (ctx.offlineMode) {
+      section->addChild(label(
+          "Update checks are disabled while offline mode is on.", Style::fontSizeCaption * scale,
+          ColorRole::OnSurfaceVariant
+      ));
+    } else if (!ctx.updateStatusText.empty()) {
+      section->addChild(label(
+          ctx.updateStatusText, Style::fontSizeBody * scale,
+          ctx.updateIsError ? ColorRole::Error : ColorRole::Secondary
+      ));
+    } else {
+      section->addChild(label(
+          "Checks GitHub for the newest stable CaeliGlow release. Installing an update is always "
+          "a separate, explicit step \u2014 this never changes anything on its own.",
+          Style::fontSizeCaption * scale, ColorRole::OnSurfaceVariant
+      ));
+    }
+  }
+
+} // namespace settings
+
+// ── SettingsWindow::checkForUpdates ────────────────────────────────────────────
+// Runs the unauthenticated release check and reflects the result into the About
+// section. Safe on lifetime grounds: SettingsWindow is a long-lived Application
+// member (close() only hides the surface), and HttpClient delivers its callback on
+// a later main-loop iteration, never reentrantly from this call.
+void SettingsWindow::checkForUpdates() {
+  if (m_httpClient == nullptr || m_aboutUpdateInFlight) {
+    return;
+  }
+  if (m_config != nullptr && m_config->config().shell.offlineMode) {
+    return; // offline mode: the About section already explains why the button is disabled
+  }
+
+  m_aboutUpdateInFlight = true;
+  m_aboutStatusText.clear();
+  m_aboutUpdateError = false;
+  requestContentRebuild();
+
+  HttpRequest req;
+  req.method = "GET";
+  req.url = caeliglow::releasesUrl();
+  req.headers = {"User-Agent: CaeliGlow", "Accept: application/vnd.github+json"};
+
+  m_httpClient->request(std::move(req), [this](HttpResponse resp) {
+    m_aboutUpdateInFlight = false;
+    const int status = resp.transportOk ? static_cast<int>(resp.status) : 0;
+    const auto result = caeliglow::evaluate(std::string(caeliglow::kCaeliGlowVersion), status, resp.body);
+    m_aboutStatusText = result.message;
+    m_aboutUpdateError =
+        result.state == caeliglow::UpdateState::Error || result.state == caeliglow::UpdateState::Offline ||
+        result.state == caeliglow::UpdateState::RateLimited;
+    requestContentRebuild();
+  });
+}
+
+// ── SettingsWindow animated About logo ─────────────────────────────────────────
+// The crescent-moon mark is a bundled animated GIF. Its frames are decoded once and
+// uploaded as GPU textures, then cycled by a one-shot Timer that re-arms itself each
+// tick (mirroring the desktop sticker widget). The About node tree is rebuilt on every
+// content change, so the Image pointer is re-attached each time while the decoded frames
+// persist; leaving the section stops the timer, and closing the window frees textures.
+
+void SettingsWindow::attachAboutLogo(Renderer& renderer, Image* image) {
+  m_aboutLogoImage = image;
+  if (image == nullptr) {
+    m_aboutLogoTimer.stop();
+    return;
+  }
+
+  if (!m_aboutLogoLoaded) {
+    m_aboutLogoLoaded = true; // decode attempt happens once per window lifetime
+    const std::string asset = paths::assetPath(kLogoAsset).string();
+    if (std::vector<std::uint8_t> bytes = FileUtils::readBinaryFile(asset); !bytes.empty()) {
+      if (auto decoded = decodeAnimatedGif(bytes.data(), bytes.size(), kMaxLogoFrames, kMaxLogoBytes)) {
+        if (decoded->frames.size() > 1) {
+          for (const auto& frame : decoded->frames) {
+            TextureHandle handle = renderer.textureManager().loadFromRgba(
+                frame.rgba.data(), decoded->width, decoded->height, /*mipmap=*/false
+            );
+            if (handle.id == 0) {
+              kAboutLog.warn("about: GPU upload failed for logo frame");
+              break;
+            }
+            m_aboutLogoFrames.push_back(handle);
+            m_aboutLogoDurations.push_back(
+                std::chrono::milliseconds(frame.durationMs == 0 ? 60U : frame.durationMs)
+            );
+          }
+        }
+      } else {
+        kAboutLog.warn("about: failed to decode logo GIF: {}", decoded.error());
+      }
+    }
+  }
+
+  if (m_aboutLogoFrames.size() > 1 && m_aboutLogoDurations.size() == m_aboutLogoFrames.size()) {
+    m_aboutLogoIndex = 0;
+    image->setExternalTexture(renderer, m_aboutLogoFrames[0]);
+    m_aboutLogoTimer.start(m_aboutLogoDurations[0], [this] { tickAboutLogo(); });
+    return;
+  }
+
+  // Single-frame or decode failure: fall back to the static rasterized first frame.
+  image->setSourceFile(renderer, paths::assetPath(kLogoAsset).string());
+}
+
+void SettingsWindow::tickAboutLogo() {
+  if (m_aboutLogoFrames.size() <= 1 || m_aboutLogoImage == nullptr || m_surface == nullptr) {
+    return;
+  }
+  Renderer& renderer = m_surface->renderTarget().renderer();
+  m_aboutLogoIndex = (m_aboutLogoIndex + 1) % m_aboutLogoFrames.size();
+  m_aboutLogoImage->setExternalTexture(renderer, m_aboutLogoFrames[m_aboutLogoIndex]);
+  requestRedraw();
+  m_aboutLogoTimer.start(m_aboutLogoDurations[m_aboutLogoIndex], [this] { tickAboutLogo(); });
+}
+
+void SettingsWindow::detachAboutLogo() {
+  m_aboutLogoTimer.stop();
+  m_aboutLogoImage = nullptr;
+}
+
+void SettingsWindow::unloadAboutLogo() {
+  m_aboutLogoTimer.stop();
+  m_aboutLogoImage = nullptr;
+  if (m_surface != nullptr) {
+    Renderer& renderer = m_surface->renderTarget().renderer();
+    for (TextureHandle& handle : m_aboutLogoFrames) {
+      renderer.textureManager().unload(handle);
+    }
+  }
+  m_aboutLogoFrames.clear();
+  m_aboutLogoDurations.clear();
+  m_aboutLogoIndex = 0;
+  m_aboutLogoLoaded = false;
+}
