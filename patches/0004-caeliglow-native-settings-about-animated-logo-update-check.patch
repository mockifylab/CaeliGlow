new file mode 100644
index 000000000..21baecdb1
--- /dev/null
+++ b/src/caeliglow/meta.hpp
@@ -0,0 +1,34 @@
+// CaeliGlow — identity + update-endpoint constants.
+//
+// The canonical CaeliGlow version is baked in at configure time via the
+// meson compile definition CAELIGLOW_VERSION (see meson.build); version.hpp
+// reads it into caeliglow::kCaeliGlowVersion. The base Noctalia release this
+// build is patched from is already exposed by Noctalia as NOCTALIA_VERSION.
+//
+// Update checks are a single unauthenticated GET to GitHub's public releases
+// endpoint for this repository — no auth, no config, no machine identifiers —
+// and the response is treated strictly as data (see update_model.hpp).
+#pragma once
+
+#include <string>
+#include <string_view>
+
+namespace caeliglow {
+
+  // Repository coordinates for the update check.
+  inline constexpr std::string_view kRepoOwner = "mockifylab";
+  inline constexpr std::string_view kRepoName = "CaeliGlow";
+
+  // GitHub public releases endpoint for the CaeliGlow repository.
+  inline const std::string& releasesUrl() {
+    static const std::string url = "https://api.github.com/repos/mockifylab/CaeliGlow/releases";
+    return url;
+  }
+
+  // Base Noctalia release this CaeliGlow build is derived from (patch series pinned to it).
+#ifndef NOCTALIA_VERSION
+#define NOCTALIA_VERSION "unknown"
+#endif
+  inline constexpr std::string_view kNoctaliaBaseVersion = NOCTALIA_VERSION;
+
+}  // namespace caeliglow
diff --git a/src/caeliglow/update_model.hpp b/src/caeliglow/update_model.hpp
new file mode 100644
index 000000000..83af21303
--- /dev/null
+++ b/src/caeliglow/update_model.hpp
@@ -0,0 +1,199 @@
+// CaeliGlow - update checker model (feature #5).
+//
+// The transport layer (HTTP fetch) lives in the native Settings integration and
+// in build tooling; this header contains only the pure, testable decision logic
+// so it can be unit tested with mocked responses for: current version, newer
+// version, network failure, rate limit, malformed data, and missing notes.
+//
+// Privacy/safety guarantees enforced by design here and in callers:
+//   * The request is a GET to GitHub's public releases endpoint with NO
+//     authentication, NO user config, NO machine identifiers.
+//   * Release notes are treated strictly as text. They are never parsed as
+//     HTML/Markdown-as-code and never executed. Installation is never implicit:
+//     evaluate() only reports state; a separate, explicit user action runs the
+//     update script, which itself backs up and validates before touching files.
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+
+#include "version.hpp"
+
+namespace caeliglow {
+
+// The states the About/update UI can display.
+enum class UpdateState {
+  Checking,         // request in flight
+  UpToDate,         // installed is the newest known release
+  UpdateAvailable,  // a newer release exists
+  NoReleases,       // repository reachable but has no releases yet
+  Offline,          // network failure / timeout / no connectivity
+  RateLimited,      // GitHub API rate limit (HTTP 403/429)
+  Error,            // malformed or otherwise unusable response
+};
+
+// A minimal view of one GitHub release record.
+struct ReleaseInfo {
+  std::string tag;      // e.g. "v1.2.0"
+  std::string name;     // human title, may be empty
+  std::string notes;    // body, may be empty
+  bool prerelease = false;
+};
+
+// A release with its parsed semantic version, used for ordering.
+struct ParsedRelease {
+  ReleaseInfo info;
+  Semver version;
+};
+
+struct UpdateResult {
+  UpdateState state = UpdateState::Checking;
+  std::string installedVersion;
+  std::string latestVersion;  // tag of newest release when UpdateAvailable
+  std::string notes;          // release notes when UpdateAvailable
+  std::string message;        // human-readable summary for the UI
+};
+
+inline const char* toString(UpdateState s) {
+  switch (s) {
+    case UpdateState::Checking: return "checking";
+    case UpdateState::UpToDate: return "up-to-date";
+    case UpdateState::UpdateAvailable: return "update-available";
+    case UpdateState::NoReleases: return "no-releases";
+    case UpdateState::Offline: return "offline";
+    case UpdateState::RateLimited: return "rate-limited";
+    case UpdateState::Error: return "error";
+  }
+  return "unknown";
+}
+
+// Parse a GitHub "/releases" JSON array into release records. Tolerant of
+// missing fields; a non-array or structurally broken body yields an empty
+// vector and lets the caller distinguish NoReleases from Error via jsonOk.
+inline std::vector<ReleaseInfo> parseReleases(const std::string& body, bool& jsonOk) {
+  jsonOk = false;
+  std::vector<ReleaseInfo> out;
+
+  nlohmann::json root;
+  try {
+    root = nlohmann::json::parse(body);
+  } catch (const nlohmann::json::exception&) {
+    return out;  // malformed JSON
+  }
+  if (!root.is_array()) {
+    return out;  // unexpected shape
+  }
+  jsonOk = true;
+
+  for (const auto& item : root) {
+    if (!item.is_object()) {
+      continue;
+    }
+    ReleaseInfo r;
+    if (item.contains("tag_name") && item["tag_name"].is_string()) {
+      r.tag = item["tag_name"].get<std::string>();
+    }
+    if (item.contains("name") && item["name"].is_string()) {
+      r.name = item["name"].get<std::string>();
+    }
+    if (item.contains("body") && item["body"].is_string()) {
+      r.notes = item["body"].get<std::string>();
+    }
+    if (item.contains("prerelease") && item["prerelease"].is_boolean()) {
+      r.prerelease = item["prerelease"].get<bool>();
+    }
+    if (!r.tag.empty()) {
+      out.push_back(std::move(r));
+    }
+  }
+  return out;
+}
+
+// Return the highest-versioned, non-prerelease release that parses as semver.
+// Prereleases are ignored unless the installed version is itself a prerelease,
+// matching a conservative "stable channel" policy.
+inline std::optional<ParsedRelease> selectLatest(const std::vector<ReleaseInfo>& releases,
+                                                 const Semver& installed) {
+  std::optional<ParsedRelease> best;
+  bool allowPre = installed.prerelease();
+  for (const auto& r : releases) {
+    if (r.prerelease && !allowPre) {
+      continue;
+    }
+    auto v = parseVersion(r.tag);
+    if (!v) {
+      continue;
+    }
+    if (!best || compareVersion(*v, best->version) > 0) {
+      best = ParsedRelease{.info = r, .version = *v};
+    }
+  }
+  return best;
+}
+
+// Decide the UI state from an HTTP status code + body and the installed version.
+// status == 0 signals a transport failure (offline/timeout).
+inline UpdateResult evaluate(const std::string& installedVersion, int status, const std::string& body) {
+  UpdateResult res;
+  res.installedVersion = installedVersion;
+
+  auto installed = parseVersion(installedVersion);
+  if (!installed) {
+    // Unknown/invalid local version: do not compare, surface as error.
+    res.state = UpdateState::Error;
+    res.message = "Could not determine the installed CaeliGlow version.";
+    return res;
+  }
+
+  if (status == 0) {
+    res.state = UpdateState::Offline;
+    res.message = "Unable to reach GitHub. Check your network connection and try again.";
+    return res;
+  }
+  if (status == 403 || status == 429) {
+    res.state = UpdateState::RateLimited;
+    res.message = "GitHub is rate-limiting update checks right now. Try again in a few minutes.";
+    return res;
+  }
+  if (status < 200 || status >= 300) {
+    res.state = UpdateState::Error;
+    res.message = "The update check failed (HTTP " + std::to_string(status) + ").";
+    return res;
+  }
+
+  bool jsonOk = false;
+  auto releases = parseReleases(body, jsonOk);
+  if (!jsonOk) {
+    res.state = UpdateState::Error;
+    res.message = "The update server returned an unexpected response.";
+    return res;
+  }
+  if (releases.empty()) {
+    res.state = UpdateState::NoReleases;
+    res.message = "No CaeliGlow releases have been published yet.";
+    return res;
+  }
+
+  auto latest = selectLatest(releases, *installed);
+  if (!latest) {
+    res.state = UpdateState::NoReleases;
+    res.message = "No stable CaeliGlow release is available yet.";
+    return res;
+  }
+
+  res.latestVersion = latest->info.tag;
+  if (compareVersion(latest->version, *installed) > 0) {
+    res.state = UpdateState::UpdateAvailable;
+    res.notes = latest->info.notes;  // rendered as plain text by the UI
+    std::string title = latest->info.name.empty() ? latest->info.tag : latest->info.name;
+    res.message = "CaeliGlow " + title + " is available.";
+  } else {
+    res.state = UpdateState::UpToDate;
+    res.message = "You\u2019re using the latest CaeliGlow release.";
+  }
+  return res;
+}
+
+}  // namespace caeliglow
diff --git a/src/caeliglow/version.hpp b/src/caeliglow/version.hpp
new file mode 100644
index 000000000..2350dab1d
--- /dev/null
+++ b/src/caeliglow/version.hpp
@@ -0,0 +1,151 @@
+// CaeliGlow - canonical version and semantic version comparison.
+//
+// This is dependency-light (C++23 std only) so it can be unit tested in
+// isolation and reused by both the native Settings "About" section and the
+// build/release tooling. The single canonical version string lives in the
+// repository's VERSION file; it is baked in at configure time (see meson /
+// build scripts) and exposed through kCaeliGlowVersion below. No other place
+// in the app hard-codes a version string.
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace caeliglow {
+
+// Baked-in canonical version. The build defines CAELIGLOW_VERSION from the
+// VERSION file; this provides a safe fallback so headers remain usable in
+// contexts (e.g. unit tests) that do not define the macro.
+#ifndef CAELIGLOW_VERSION
+#define CAELIGLOW_VERSION "0.0.0"
+#endif
+
+inline constexpr std::string_view kCaeliGlowVersion = CAELIGLOW_VERSION;
+
+// A parsed semantic version. Supports an optional "v" prefix and an optional
+// pre-release suffix (e.g. "1.2.3-rc.1"). Only numeric major/minor/patch are
+// used for ordering; pre-release presence makes a version sort before its
+// release counterpart (1.0.0-rc.1 < 1.0.0).
+struct Semver {
+  std::int64_t major = 0;
+  std::int64_t minor = 0;
+  std::int64_t patch = 0;
+  std::string pre;  // empty when absent
+
+  bool prerelease() const { return !pre.empty(); }
+};
+
+// Parse a version string such as "v1.2.3", "1.2", "1.2.3-rc.1". Leading "v"
+// and surrounding whitespace are tolerated. Returns nullopt on malformed input.
+inline std::optional<Semver> parseVersion(std::string_view raw) {
+  auto trim = [](std::string_view s) {
+    std::size_t b = s.find_first_not_of(" \t\r\n");
+    if (b == std::string_view::npos) {
+      return std::string_view{};
+    }
+    std::size_t e = s.find_last_not_of(" \t\r\n");
+    return s.substr(b, e - b + 1);
+  };
+
+  std::string_view s = trim(raw);
+  if (!s.empty() && (s.front() == 'v' || s.front() == 'V')) {
+    s.remove_prefix(1);
+  }
+  if (s.empty()) {
+    return std::nullopt;
+  }
+
+  Semver out;
+  // Split off a pre-release / build suffix at the first '-' or '+'.
+  std::size_t sep = s.find_first_of("-+");
+  std::string_view core = (sep == std::string_view::npos) ? s : s.substr(0, sep);
+  if (sep != std::string_view::npos) {
+    out.pre = std::string(s.substr(sep));
+    // A '+' build suffix is not part of precedence ordering; drop it.
+    if (auto plus = out.pre.find('+'); plus != std::string::npos) {
+      out.pre = out.pre.substr(0, plus);
+    }
+    if (out.pre.size() > 1 && out.pre.front() == '-') {
+      out.pre.erase(out.pre.begin());  // strip leading '-'
+    }
+  }
+
+  std::vector<std::string_view> parts;
+  std::size_t pos = 0;
+  while (true) {
+    std::size_t dot = core.find('.', pos);
+    parts.push_back(core.substr(pos, dot == std::string_view::npos ? std::string_view::npos : dot - pos));
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    pos = dot + 1;
+  }
+  if (parts.empty() || parts.size() > 3) {
+    return std::nullopt;
+  }
+
+  auto number = [](std::string_view tok, std::int64_t& into) {
+    if (tok.empty()) {
+      return false;
+    }
+    std::int64_t acc = 0;
+    for (char c : tok) {
+      if (c < '0' || c > '9') {
+        return false;
+      }
+      acc = acc * 10 + (c - '0');
+    }
+    into = acc;
+    return true;
+  };
+
+  if (!number(parts[0], out.major)) {
+    return std::nullopt;
+  }
+  if (parts.size() > 1 && !number(parts[1], out.minor)) {
+    return std::nullopt;
+  }
+  if (parts.size() > 2 && !number(parts[2], out.patch)) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+// Three-way compare: negative if a<b, 0 if equal, positive if a>b.
+// Pre-release ordering follows the common semver rule: a version with a
+// pre-release sorts before the same version without one.
+inline int compareVersion(const Semver& a, const Semver& b) {
+  if (a.major != b.major) {
+    return a.major < b.major ? -1 : 1;
+  }
+  if (a.minor != b.minor) {
+    return a.minor < b.minor ? -1 : 1;
+  }
+  if (a.patch != b.patch) {
+    return a.patch < b.patch ? -1 : 1;
+  }
+  if (a.pre == b.pre) {
+    return 0;
+  }
+  if (a.pre.empty()) {
+    return 1;  // release > prerelease
+  }
+  if (b.pre.empty()) {
+    return -1;
+  }
+  return a.pre < b.pre ? -1 : 1;
+}
+
+inline std::optional<int> compareVersion(std::string_view a, std::string_view b) {
+  auto pa = parseVersion(a);
+  auto pb = parseVersion(b);
+  if (!pa || !pb) {
+    return std::nullopt;
+  }
+  return compareVersion(*pa, *pb);
+}
+
+}  // namespace caeliglow
