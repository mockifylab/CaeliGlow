diff --git a/tests/glyph_registry_test.cpp b/tests/glyph_registry_test.cpp
new file mode 100644
index 000000000..d0cbd214e
--- /dev/null
+++ b/tests/glyph_registry_test.cpp
@@ -0,0 +1,171 @@
+// Guards the CaeliGlow outlined icon house style: every semantic alias in
+// glyph_registry.cpp must resolve to a real Tabler glyph, shell-facing names
+// must not silently fall back to the missing-glyph skull, and state glyphs
+// stay outlined (media transport and the verified-plugin badge are exempt).
+#include "render/text/glyph_registry.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <nlohmann/json.hpp>
+#include <print>
+#include <regex>
+#include <string>
+#include <vector>
+
+namespace {
+
+  constexpr char32_t kMissingGlyph = 0xF292; // skull, same constant as the registry
+
+  bool expectOk(bool condition, const std::string& message) {
+    if (!condition) {
+      std::println(stderr, "glyph_registry_test: {}", message);
+      return false;
+    }
+    return true;
+  }
+
+  [[nodiscard]] std::vector<std::pair<std::string, std::string>> parseAliases() {
+    std::vector<std::pair<std::string, std::string>> aliases;
+    std::ifstream file(MESON_SOURCE_ROOT "/src/render/text/glyph_registry.cpp");
+    if (!file.is_open()) {
+      return aliases;
+    }
+    const std::string text{std::istreambuf_iterator<char>{file}, std::istreambuf_iterator<char>{}};
+    // Entries look like: {"alias-name", "tabler-name"},
+    static const std::regex entryRegex(R"(\{\s*\"([a-z0-9-]+)\",\s*\"([a-z0-9-]+)\"\s*\})");
+    for (auto it = std::sregex_iterator(text.begin(), text.end(), entryRegex); it != std::sregex_iterator(); ++it) {
+      aliases.emplace_back((*it)[1].str(), (*it)[2].str());
+    }
+    return aliases;
+  }
+
+  [[nodiscard]] const nlohmann::json& tablerMetadata() {
+    static const nlohmann::json root = [] {
+      std::ifstream file(MESON_SOURCE_ROOT "/assets/fonts/tabler.json");
+      return nlohmann::json::parse(file, nullptr, false);
+    }();
+    return root;
+  }
+
+  [[nodiscard]] std::optional<char32_t> nativeCodepoint(std::string_view name) {
+    const auto& root = tablerMetadata();
+    if (!root.is_object()) {
+      return std::nullopt;
+    }
+    const auto it = root.find(std::string{name});
+    if (it == root.end() || !it->is_object()) {
+      return std::nullopt;
+    }
+    const auto cp = it->find("codepoint");
+    if (cp == it->end() || !cp->is_string()) {
+      return std::nullopt;
+    }
+    const std::string literal = cp->get<std::string>();
+    const char32_t parsed = GlyphRegistry::lookup(literal);
+    if (parsed == kMissingGlyph) {
+      return std::nullopt;
+    }
+    return parsed;
+  }
+
+} // namespace
+
+int main() {
+  bool ok = true;
+
+  const auto aliases = parseAliases();
+  ok = expectOk(aliases.size() >= 70, "parsed only " + std::to_string(aliases.size()) + " aliases from the registry");
+
+  // Filled glyphs stay reserved for indicators that sit inside filled tiles
+  // (media transport) and the verified-plugin badge. Everything the shell
+  // paints as a plain outlined icon must resolve to a non-filled glyph.
+  const std::vector<std::string> kFilledAllowed = {
+      "media-pause", "media-play", "media-prev", "media-next", "stop", "official-plugin",
+  };
+
+  for (const auto& [alias, target] : aliases) {
+    ok = expectOk(nativeCodepoint(target).has_value(), "alias '" + alias + "' targets unknown glyph '" + target + "'");
+    const char32_t viaAlias = GlyphRegistry::lookup(alias);
+    ok = expectOk(viaAlias != kMissingGlyph, "alias '" + alias + "' resolves to the missing-glyph skull");
+    if (const auto cp = nativeCodepoint(target); cp.has_value()) {
+      ok = expectOk(
+          viaAlias == *cp,
+          "alias '"
+              + alias
+              + "' resolves to U+"
+              + std::format("{:X}", static_cast<std::uint32_t>(viaAlias))
+              + ", expected its target '"
+              + target
+              + "' at U+"
+              + std::format("{:X}", static_cast<std::uint32_t>(*cp))
+      );
+    }
+    const bool filled = target.ends_with("-filled");
+    if (filled) {
+      const bool exempt = std::any_of(kFilledAllowed.begin(), kFilledAllowed.end(), [&alias](const std::string& name) {
+        return name == alias;
+      });
+      ok = expectOk(exempt, "alias '" + alias + "' points at filled glyph '" + target + "' outside the allowlist");
+    }
+  }
+
+  // Names the shell hard-codes must resolve (a typo here renders a skull at runtime).
+  const std::vector<std::string> kShellNames = {
+      "close",
+      "add",
+      "settings",
+      "shutdown",
+      "reboot",
+      "suspend",
+      "lock",
+      "logout",
+      "refresh",
+      "device-desktop",
+      "brightness-low",
+      "brightness-high",
+      "weather-cloud",
+      "weather-cloud-sun",
+      "headphones",
+      "repeat",
+      "shuffle",
+      "media-play",
+      "disc",
+      "clock",
+      "bolt",
+      "alert-triangle",
+      "app-window",
+      "storage",
+      "key",
+      "shield-lock",
+      "plug",
+      "plug-off",
+      "check",
+      "map-pin-off",
+      "search",
+      "terminal",
+      "calculator",
+      "power",
+      "rectangle",
+      "theme-mode",
+      "caffeine-on",
+      "caffeine-off",
+      "volume-high",
+      "volume-low",
+      "volume-mute",
+      "battery-plugged",
+  };
+  for (const std::string& name : kShellNames) {
+    ok = expectOk(GlyphRegistry::lookup(name) != kMissingGlyph, "shell glyph name '" + name + "' does not resolve");
+  }
+
+  // A name that does not exist must keep reporting the skull so this test's
+  // guarantees above are actually load-bearing.
+  ok = expectOk(
+      GlyphRegistry::lookup("file-lock") == kMissingGlyph,
+      "'file-lock' unexpectedly resolves; the skull sentinel no longer detects gaps"
+  );
+
+  return ok ? 0 : 1;
+}
