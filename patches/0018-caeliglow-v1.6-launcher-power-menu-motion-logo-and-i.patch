+void Button::animateGlyphLift(bool hovered) {
+  if (m_glyph == nullptr) {
+    return;
+  }
+  // Disabled and hover-suppressed buttons get no lift, in either direction.
+  if (!m_enabled || m_hoverSuppressed) {
+    hovered = false;
+  }
+  constexpr float kHoverScale = 1.06F;
+  constexpr float kGlyphLiftMs = 140.0F;
+  const float to = hovered ? kHoverScale : 1.0F;
+  if (to == m_glyph->scale()) {
+    return;
+  }
+  if (animationManager() == nullptr) {
+    m_glyph->setScale(to);
+    return;
+  }
+  if (m_glyphAnimId != 0) {
+    animationManager()->cancel(m_glyphAnimId);
+    m_glyphAnimId = 0;
+  }
+  // MotionService disabled or reduced motion active: AnimationManager::animate
+  // snaps straight to the target, so the lift never becomes a bounce.
+  m_glyphAnimId = animationManager()->animate(
+      m_glyph->scale(), to, kGlyphLiftMs, Easing::EaseOutCubic, [this](float value) { m_glyph->setScale(value); },
+      [this] { m_glyphAnimId = 0; }, m_glyph
+  );
