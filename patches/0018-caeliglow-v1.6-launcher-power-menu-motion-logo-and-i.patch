-  enum class Motion : std::uint8_t { Classic = 0, Soft = 1, Fizzy = 2, Morphy = 3 };
+  // Panel open/close motion language. The four originals are unchanged so existing
+  // configs keep working; the added presets round the set out to ten fluid morph
+  // styles spanning balanced, smooth, minimal/reduced and playful. Selected in
+  // Settings > CaeliGlow (a segmented picker); each preset also drives duration
+  // scale and the squash-and-stretch amplitude in PanelManager::panelMotion().
+  enum class Motion : std::uint8_t {
+    Classic = 0,
+    Soft = 1,
+    Fizzy = 2,
+    Morphy = 3,
+    // CaeliGlow v1.6 fluid-morph presets.
+    Gentle = 4, // balanced, single soft settle (no bounce)
+    Glide = 5,  // long, even in/out ease — very calm
+    Fluid = 6,  // deep smooth quint ease, subtle overshoot
+    Snappy = 7, // quick, tight, minimal travel
+    Bounce = 8, // playful pronounced spring + squash
+    Calm = 9,   // reduced-motion friendly: short, no overshoot
+  };
   Motion motion = Motion::Fizzy;
+  // Master reduced-motion switch: forces the shortest, overshoot-free timing and
+  // disables hover/squash embellishments shell-wide (icons, panel pulses).
+  bool reduceMotion = false;
