diff --git a/src/caeliglow/animated_image.cpp b/src/caeliglow/animated_image.cpp
new file mode 100644
index 000000000..6e0fec44e
--- /dev/null
+++ b/src/caeliglow/animated_image.cpp
@@ -0,0 +1,119 @@
+// CaeliGlow — reusable animated-GIF image driver. See animated_image.h.
+#include "caeliglow/animated_image.h"
+
+#include "core/files/resource_paths.h"
+#include "render/core/image_decoder.h"
+#include "render/core/renderer.h"
+#include "render/core/texture_manager.h"
+#include "ui/controls/image.h"
+#include "util/file_utils.h"
+
+#include <utility>
+
+namespace caeliglow {
+
+  AnimatedImage::~AnimatedImage() = default; // textures are freed via unload() while the renderer is alive
+
+  bool AnimatedImage::load(Renderer& renderer, int slot, const std::string& assetRel) {
+    if (slot < 0 || slot >= kSlotCount) {
+      return false;
+    }
+    Set& set = m_sets[slot];
+    for (Frame& frame : set.frames) {
+      renderer.textureManager().unload(frame.texture);
+    }
+    set.frames.clear();
+    set.index = 0;
+    set.elapsedMs = 0.0;
+
+    const std::string path = paths::assetPath(assetRel).string();
+    const std::vector<std::uint8_t> bytes = FileUtils::readBinaryFile(path);
+    if (bytes.empty()) {
+      return false;
+    }
+    auto decoded = decodeAnimatedGif(bytes.data(), bytes.size(), kMaxFrames, kMaxRgbaBytes);
+    if (!decoded) {
+      return false;
+    }
+    for (const DecodedRasterFrame& frame : decoded->frames) {
+      TextureHandle handle =
+          renderer.textureManager().loadFromRgba(frame.rgba.data(), decoded->width, decoded->height, /*mipmap=*/false);
+      if (handle.id == 0) {
+        break; // GPU upload failed; keep whatever frames did land
+      }
+      set.frames.push_back(Frame{.texture = handle, .durationMs = frame.durationMs == 0 ? 60U : frame.durationMs});
+    }
+    return set.frames.size() > 1;
+  }
+
+  void AnimatedImage::attach(Renderer& renderer, Image* image) {
+    m_image = image;
+    applyFrame(renderer);
+  }
+
+  void AnimatedImage::detach() { m_image = nullptr; }
+
+  void AnimatedImage::setActiveSet(Renderer& renderer, int slot) {
+    if (slot < 0 || slot >= kSlotCount || slot == m_active) {
+      return;
+    }
+    if (m_sets[slot].frames.empty()) {
+      return; // no asset for this state; keep the current animation
+    }
+    m_active = slot;
+    m_sets[slot].index = 0;
+    m_sets[slot].elapsedMs = 0.0;
+    applyFrame(renderer);
+  }
+
+  bool AnimatedImage::advance(Renderer& renderer, float deltaMs) {
+    Set& set = m_sets[m_active];
+    if (set.frames.size() <= 1 || m_image == nullptr) {
+      return false;
+    }
+    set.elapsedMs += static_cast<double>(deltaMs);
+    bool changed = false;
+    // Follow through on short frames so a slow tick still advances correctly.
+    while (set.elapsedMs >= static_cast<double>(set.frames[set.index].durationMs)) {
+      set.elapsedMs -= static_cast<double>(set.frames[set.index].durationMs);
+      set.index = (set.index + 1) % set.frames.size();
+      changed = true;
+      if (set.elapsedMs < static_cast<double>(set.frames[set.index].durationMs)) {
+        break;
+      }
+    }
+    if (changed) {
+      applyFrame(renderer);
+    }
+    return changed;
+  }
+
+  bool AnimatedImage::isAnimating() const noexcept {
+    return m_image != nullptr && m_sets[m_active].frames.size() > 1;
+  }
+
+  void AnimatedImage::unload(Renderer& renderer) {
+    m_image = nullptr;
+    for (Set& set : m_sets) {
+      for (Frame& frame : set.frames) {
+        renderer.textureManager().unload(frame.texture);
+      }
+      set.frames.clear();
+      set.index = 0;
+      set.elapsedMs = 0.0;
+    }
+    m_active = kIdle;
+  }
+
+  void AnimatedImage::applyFrame(Renderer& renderer) {
+    if (m_image == nullptr) {
+      return;
+    }
+    const Set& set = m_sets[m_active];
+    if (set.frames.empty()) {
+      return;
+    }
+    m_image->setExternalTexture(renderer, set.frames[set.index].texture);
+  }
+
+} // namespace caeliglow
diff --git a/src/caeliglow/animated_image.h b/src/caeliglow/animated_image.h
new file mode 100644
index 000000000..b22b12c90
--- /dev/null
+++ b/src/caeliglow/animated_image.h
@@ -0,0 +1,83 @@
+#pragma once
+// CaeliGlow — reusable animated-GIF image driver.
+//
+// Mirrors the mechanism Noctalia's own desktop-sticker widget (and the CaeliGlow
+// Settings About logo, patch 0004) uses: decode a bundled GIF once into GPU
+// textures, then cycle them on an Image node via Image::setExternalTexture. This
+// helper holds two frame sets (idle + hover) so a control can animate differently
+// while the pointer is over it. It owns no timer: the host drives advance() from
+// its per-frame tick, which keeps the loop tied to the panel's real lifetime.
+//
+// MIT licensed; independent of Caelestia.
+
+#include "render/core/texture_handle.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+class Image;
+class Renderer;
+
+namespace caeliglow {
+
+  class AnimatedImage {
+  public:
+    static constexpr int kIdle = 0;
+    static constexpr int kHover = 1;
+    static constexpr int kSlotCount = 2;
+
+    // Resource caps for one resident frame set (well within budget at 96px).
+    static constexpr int kMaxFrames = 64;
+    static constexpr std::size_t kMaxRgbaBytes = 8ULL * 1024 * 1024;
+
+    AnimatedImage() = default;
+    ~AnimatedImage();
+    AnimatedImage(const AnimatedImage&) = delete;
+    AnimatedImage& operator=(const AnimatedImage&) = delete;
+
+    // Decode + upload the GIF at `assetRel` into `slot`. Any previous frames in
+    // that slot are freed first. Returns true when the result is a real animation
+    // (more than one usable frame).
+    bool load(Renderer& renderer, int slot, const std::string& assetRel);
+
+    // (Re)point the animator at an Image node and show the current frame. Called
+    // whenever the host rebuilds its scene, since the node pointer changes.
+    void attach(Renderer& renderer, Image* image);
+    // Stop targeting a node (e.g. before the scene is torn down). Textures persist.
+    void detach();
+
+    // Switch the active frame set (kIdle / kHover). No-op when that set is empty,
+    // so a missing hover asset silently keeps the idle animation.
+    void setActiveSet(Renderer& renderer, int slot);
+
+    // Advance the active frame by `deltaMs`; returns true when the displayed frame
+    // changed (the host repaints when this is true).
+    bool advance(Renderer& renderer, float deltaMs);
+
+    // True when the active set has more than one frame and a node is attached.
+    [[nodiscard]] bool isAnimating() const noexcept;
+
+    // Free every uploaded texture. Call while the renderer is still alive.
+    void unload(Renderer& renderer);
+
+  private:
+    struct Frame {
+      TextureHandle texture;
+      std::uint32_t durationMs = 0;
+    };
+    struct Set {
+      std::vector<Frame> frames;
+      std::size_t index = 0;
+      double elapsedMs = 0.0;
+    };
+
+    void applyFrame(Renderer& renderer);
+
+    Set m_sets[kSlotCount];
+    int m_active = kIdle;
+    Image* m_image = nullptr;
+  };
+
+} // namespace caeliglow
