+// right-edge hover trigger (instead of Noctalia's native SessionPanel). Top to bottom:
+// Logout, Power (shutdown), the animated crescent-moon logo, Lock, Restart. Destructive
+// actions arm a short confirm countdown (re-activate to run immediately); Lock is
+// immediate. Every command is resolved through Noctalia's SessionActionRunner, so no
+// paths are hard-coded here. The middle logo idles with the calm twinkle and switches to
+// a livelier animation while the pointer is over it.
+//
+// MIT licensed; the visual concept is re-implemented from scratch, no Caelestia code.
+
+#include "caeliglow/animated_image.h"
+#include "config/config_types.h"
+#include "shell/panel/panel.h"
+
+#include <cstddef>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+class Box;
+class Button;
+class ConfigService;
+class CountdownRing;
+class Flex;
+class Image;
+class Renderer;
+class SessionActionRunner;
+
+class CaeliGlowPowerPanel : public Panel {
+public:
+  CaeliGlowPowerPanel(ConfigService* config, SessionActionRunner& actionRunner);
+  ~CaeliGlowPowerPanel() override;
+
+  void create() override;
+  void onOpen(std::string_view context) override;
+  void onClose() override;
+  void onFrameTick(float deltaMs) override;
+
+  [[nodiscard]] float preferredWidth() const override;
+  [[nodiscard]] float preferredHeight() const override;
+
+  [[nodiscard]] PanelPlacement panelPlacement() const noexcept override { return PanelPlacement::Floating; }
+  [[nodiscard]] std::string panelScreenPosition() const override { return "center_right"; }
+  [[nodiscard]] LayerShellKeyboard keyboardMode() const override { return LayerShellKeyboard::OnDemand; }
+  [[nodiscard]] bool dismissOnOutsideClick() const override { return true; }
+
+private:
+  struct CountdownOverlay {
+    Flex* root = nullptr;
+    Box* scrim = nullptr;
+    CountdownRing* ring = nullptr;
+  };
+  struct Entry {
+    SessionPanelActionConfig cfg;
