diff --git a/src/shell/session/caeliglow_power_panel.cpp b/src/shell/session/caeliglow_power_panel.cpp
new file mode 100644
index 000000000..6a76f190a
--- /dev/null
+++ b/src/shell/session/caeliglow_power_panel.cpp
@@ -0,0 +1,398 @@
+// CaeliGlow — Caelestia-style right-edge session panel. See caeliglow_power_panel.h.
+#include "shell/session/caeliglow_power_panel.h"
+
+#include "config/config_service.h"
+#include "core/deferred_call.h"
+#include "core/log.h"
+#include "i18n/i18n.h"
+#include "shell/panel/panel_manager.h"
+#include "shell/session/session_action_meta.h"
+#include "shell/session/session_action_runner.h"
+#include "ui/builders.h"
+#include "ui/controls/box.h"
+#include "ui/controls/button.h"
+#include "ui/controls/countdown_ring.h"
+#include "ui/controls/flex.h"
+#include "ui/controls/image.h"
+#include "ui/palette.h"
+#include "ui/style.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <memory>
+#include <string>
+#include <utility>
+
+namespace {
+  constexpr Logger kLog("caeliglow");
+  constexpr float kCountdownScrimAlpha = 0.58F;
+} // namespace
+
+CaeliGlowPowerPanel::CaeliGlowPowerPanel(ConfigService* config, SessionActionRunner& actionRunner)
+    : m_config(config), m_actionRunner(&actionRunner) {}
+
+CaeliGlowPowerPanel::~CaeliGlowPowerPanel() = default;
+
+float CaeliGlowPowerPanel::preferredWidth() const {
+  return scaled(kLogoSize + Style::panelPadding * 2.0F);
+}
+
+float CaeliGlowPowerPanel::preferredHeight() const {
+  const float gap = Style::spaceSm;
+  const float h = kButtonSize * 4.0F + kLogoSize + gap * 4.0F + Style::panelPadding * 2.0F;
+  return std::ceil(scaled(h));
+}
+
+void CaeliGlowPowerPanel::create() {
+  const float scale = contentScale();
+  m_entries.clear();
+  m_logoButton = nullptr;
+  m_logoImage = nullptr;
+
+  auto rootCol = ui::column({
+      .out = &m_rootLayout,
+      .align = FlexAlign::Center,
+      .justify = FlexJustify::Center,
+      .gap = Style::spaceSm * scale,
+      .padding = Style::panelPadding * scale,
+  });
+  Flex* root = rootCol.get();
+
+  // Reference order (top -> bottom): Logout, Power, [logo], Lock, Restart.
+  auto makeEntry = [this](const char* action, bool destructive) {
+    Entry e;
+    e.cfg.action = action;
+    e.cfg.countdownSeconds = destructive ? kDestructiveCountdownSeconds : 0.0;
+    m_entries.push_back(std::move(e));
+  };
+  makeEntry("logout", true);   // 0
+  makeEntry("shutdown", true); // 1
+  makeEntry("lock", false);    // 2
+  makeEntry("reboot", true);   // 3
+
+  // The animated logo button (built now, inserted between Power and Lock below).
+  auto logoBtn = ui::button({
+      .variant = ButtonVariant::Ghost,
+      .surfaceOpacity = panelCardOpacity(),
+      .tooltip = std::string("CaeliGlow"),
+      .radius = Style::scaledRadiusLg(scale),
+      .width = kLogoSize * scale,
+      .height = kLogoSize * scale,
+      .onEnter = [this]() {
+        if (m_renderer != nullptr) {
+          m_logoAnim.setActiveSet(*m_renderer, caeliglow::AnimatedImage::kHover);
+          PanelManager::instance().requestFrameTick();
+        }
+      },
+      .onLeave = [this]() {
+        if (m_renderer != nullptr) {
+          m_logoAnim.setActiveSet(*m_renderer, caeliglow::AnimatedImage::kIdle);
+          PanelManager::instance().requestFrameTick();
+        }
+      },
+      .configure = [](Button& b) {
+        b.setTabStop(false);
+        b.setAlign(FlexAlign::Center);
+        b.setJustify(FlexJustify::Center);
+      },
+  });
+  m_logoButton = logoBtn.get();
+  m_logoButton->addChild(ui::image({
+      .out = &m_logoImage,
+      .fit = ImageFit::Contain,
+      .width = kLogoSize * scale,
+      .height = kLogoSize * scale,
+  }));
+
+  for (std::size_t i = 0; i < m_entries.size(); ++i) {
+    std::unique_ptr<Button> btn(createActionButton(m_entries[i].cfg, i, scale));
+    m_entries[i].button = btn.get();
+    if (m_entries[i].cfg.countdownSeconds > 0.0) {
+      attachCountdownOverlay(*btn, m_entries[i].overlay, scale);
+    }
+    root->addChild(std::move(btn));
+    if (i == 1) {
+      root->addChild(std::move(logoBtn)); // logo sits between Power and Lock
+    }
+  }
+
+  setRoot(std::move(rootCol));
+  if (m_animations != nullptr) {
+    Panel::root()->setAnimationManager(m_animations);
+  }
+}
+
+Button* CaeliGlowPowerPanel::createActionButton(const SessionPanelActionConfig& cfg, std::size_t index, float scale) {
+  const std::string glyph = cfg.glyph.has_value() && !cfg.glyph->empty() ? *cfg.glyph
+                                                                         : session_action::defaultGlyph(cfg.action);
+  const std::string tip =
+      cfg.label.has_value() && !cfg.label->empty() ? *cfg.label : i18n::tr(session_action::labelKey(cfg.action));
+
+  auto button = ui::button({
+      .glyph = glyph,
+      .glyphSize = 24.0F * scale,
+      .contentAlign = ButtonContentAlign::Center,
+      .variant = ButtonVariant::Ghost,
+      .surfaceOpacity = panelCardOpacity(),
+      .tooltip = tip,
+      .radius = Style::scaledRadiusLg(scale),
+      .width = kButtonSize * scale,
+      .height = kButtonSize * scale,
+      .onClick = [this, index]() { armEntry(index); },
+      .configure = [](Button& b) {
+        b.setTabStop(false);
+        b.setAlign(FlexAlign::Center);
+        b.setJustify(FlexJustify::Center);
+      },
+  });
+  return button.release();
+}
+
+void CaeliGlowPowerPanel::attachCountdownOverlay(Button& button, CountdownOverlay& overlay, float scale) {
+  const float ringSize = 44.0F * scale;
+
+  auto overlayRoot = ui::column({
+      .out = &overlay.root,
+      .align = FlexAlign::Center,
+      .justify = FlexJustify::Center,
+      .visible = false,
+      .participatesInLayout = false,
+      .configure = [](Flex& root) { root.setZIndex(0); },
+  });
+
+  auto scrim = ui::box({
+      .out = &overlay.scrim,
+      .radius = Style::scaledRadiusLg(scale),
+      .participatesInLayout = false,
+      .configure = [](Box& box) { box.setZIndex(0); },
+  });
+  overlayRoot->addChild(std::move(scrim));
+
+  auto ring = std::make_unique<CountdownRing>();
+  ring->setRingSize(ringSize);
+  ring->setThickness(std::max(4.0F, 4.5F * scale));
+  ring->setFontSize(18.0F * scale);
+  ring->setParticipatesInLayout(false);
+  ring->setZIndex(1);
+  overlay.ring = ring.get();
+  overlayRoot->addChild(std::move(ring));
+
+  button.addChild(std::move(overlayRoot));
+}
+
+void CaeliGlowPowerPanel::ensureLogoLoaded(Renderer& renderer) {
+  m_renderer = &renderer;
+  if (!m_assetsLoaded) {
+    m_assetsLoaded = true;
+    const bool idle = m_logoAnim.load(renderer, caeliglow::AnimatedImage::kIdle, "caeliglow/logo-panel-idle.gif");
+    m_logoAnim.load(renderer, caeliglow::AnimatedImage::kHover, "caeliglow/logo-panel-hover.gif");
+    if (!idle) {
+      kLog.warn("power panel: logo animation unavailable, using whatever frame decoded");
+    }
+  }
+  if (m_logoImage != nullptr) {
+    m_logoAnim.attach(renderer, m_logoImage);
+  }
+}
+
+void CaeliGlowPowerPanel::doLayout(Renderer& renderer, float width, float height) {
+  ensureLogoLoaded(renderer);
+  if (m_rootLayout == nullptr) {
+    return;
+  }
+  m_rootLayout->setSize(width, height);
+  m_rootLayout->layout(renderer);
+  for (Entry& entry : m_entries) {
+    if (entry.button != nullptr) {
+      entry.button->updateInputArea();
+    }
+  }
+  if (m_logoButton != nullptr) {
+    m_logoButton->updateInputArea();
+  }
+  layoutOverlays(renderer);
+  if (m_logoAnim.isAnimating()) {
+    PanelManager::instance().requestFrameTick();
+  }
+}
+
+void CaeliGlowPowerPanel::doUpdate(Renderer& renderer) { ensureLogoLoaded(renderer); }
+
+void CaeliGlowPowerPanel::onPanelCardOpacityChanged(float opacity) {
+  if (m_logoButton != nullptr) {
+    m_logoButton->setSurfaceOpacity(opacity);
+  }
+  for (Entry& entry : m_entries) {
+    if (entry.button != nullptr) {
+      entry.button->setSurfaceOpacity(opacity);
+    }
+  }
+}
+
+void CaeliGlowPowerPanel::onOpen(std::string_view /*context*/) {
+  m_pendingIndex.reset();
+  m_actionQueued = false;
+  hideOverlays();
+  PanelManager::instance().requestFrameTick();
+}
+
+void CaeliGlowPowerPanel::onClose() {
+  m_pendingIndex.reset();
+  m_actionQueued = false;
+  hideOverlays();
+  m_logoAnim.detach();
+  m_rootLayout = nullptr;
+  m_logoButton = nullptr;
+  m_logoImage = nullptr;
+  m_entries.clear();
+  clearReleasedRoot();
+}
+
+void CaeliGlowPowerPanel::armEntry(std::size_t index) {
+  if (index >= m_entries.size() || m_actionQueued) {
+    return;
+  }
+  const Entry& entry = m_entries[index];
+  if (entry.cfg.countdownSeconds <= 0.0) {
+    executeEntry(index); // Lock: immediate
+    return;
+  }
+  if (m_pendingIndex.has_value() && *m_pendingIndex == index) {
+    executeEntry(index); // second activation confirms now
+    return;
+  }
+  m_pendingIndex = index;
+  m_totalMs = entry.cfg.countdownSeconds * 1000.0;
+  m_remainingMs = m_totalMs;
+  hideOverlays();
+  showOverlay(index);
+  PanelManager::instance().requestFrameTick();
+  PanelManager::instance().refresh();
+}
+
+void CaeliGlowPowerPanel::executeEntry(std::size_t index) {
+  if (index >= m_entries.size() || m_actionQueued) {
+    return;
+  }
+  SessionActionRunner* const runner = m_actionRunner;
+  if (runner == nullptr) {
+    kLog.warn("power panel: action runner unavailable");
+    return;
+  }
+  const SessionPanelActionConfig cfg = m_entries[index].cfg;
+  m_actionQueued = true;
+  m_pendingIndex.reset();
+  hideOverlays();
+  DeferredCall::callLater([runner, cfg]() {
+    auto& manager = PanelManager::instance();
+    if (cfg.action == "lock" || cfg.action == "lock_and_suspend") {
+      manager.closePanelForCapture([runner, cfg]() { runner->invoke(cfg); });
+      return;
+    }
+    manager.closePanel(/*animateClose=*/false);
+    runner->invoke(cfg);
+  });
+}
+
+void CaeliGlowPowerPanel::cancelCountdown() {
+  m_pendingIndex.reset();
+  hideOverlays();
+  PanelManager::instance().refresh();
+}
+
+void CaeliGlowPowerPanel::hideOverlays() {
+  for (Entry& entry : m_entries) {
+    if (entry.overlay.root != nullptr) {
+      entry.overlay.root->setVisible(false);
+    }
+  }
+}
+
+void CaeliGlowPowerPanel::showOverlay(std::size_t index) {
+  if (index >= m_entries.size()) {
+    return;
+  }
+  Entry& entry = m_entries[index];
+  if (entry.overlay.root == nullptr) {
+    return;
+  }
+  entry.overlay.root->setVisible(true);
+  syncOverlayColors(index);
+  if (entry.overlay.ring != nullptr) {
+    entry.overlay.ring->setProgress(1.0F);
+    entry.overlay.ring->setSeconds(static_cast<int>(std::ceil(m_totalMs / 1000.0)));
+  }
+}
+
+void CaeliGlowPowerPanel::syncOverlayColors(std::size_t index) {
+  if (index >= m_entries.size()) {
+    return;
+  }
+  Entry& entry = m_entries[index];
+  const Button::ButtonPalette btnPalette = Button::defaultPalette(ButtonVariant::Ghost);
+  const Button::ButtonStateColors& state = btnPalette.pressed;
+  ColorSpec scrimFill = state.bg;
+  scrimFill.alpha *= kCountdownScrimAlpha;
+  if (entry.overlay.scrim != nullptr) {
+    entry.overlay.scrim->setFill(scrimFill);
+  }
+  if (entry.overlay.ring != nullptr) {
+    entry.overlay.ring->setColor(state.label);
+  }
+}
+
+void CaeliGlowPowerPanel::layoutOverlays(Renderer& renderer) {
+  for (Entry& entry : m_entries) {
+    if (entry.button == nullptr || entry.overlay.root == nullptr) {
+      continue;
+    }
+    const float w = entry.button->width();
+    const float h = entry.button->height();
+    entry.overlay.root->setPosition(0.0F, 0.0F);
+    entry.overlay.root->setFrameSize(w, h);
+    if (entry.overlay.scrim != nullptr) {
+      entry.overlay.scrim->setPosition(0.0F, 0.0F);
+      entry.overlay.scrim->setFrameSize(w, h);
+      entry.overlay.scrim->setSize(w, h);
+    }
+    if (entry.overlay.ring != nullptr) {
+      const float ringSize = entry.overlay.ring->ringSize();
+      entry.overlay.ring->setPosition((w - ringSize) * 0.5F, (h - ringSize) * 0.5F);
+      entry.overlay.ring->layout(renderer);
+    }
+  }
+}
+
+void CaeliGlowPowerPanel::onFrameTick(float deltaMs) {
+  bool keepTicking = false;
+
+  if (m_renderer != nullptr && m_logoAnim.isAnimating()) {
+    m_logoAnim.advance(*m_renderer, deltaMs);
+    keepTicking = true;
+  }
+
+  if (m_pendingIndex.has_value()) {
+    const std::size_t index = *m_pendingIndex;
+    m_remainingMs -= static_cast<double>(deltaMs);
+    if (m_remainingMs <= 0.0) {
+      executeEntry(index);
+      return;
+    }
+    if (index < m_entries.size() && m_entries[index].overlay.ring != nullptr) {
+      const float progress =
+          m_totalMs > 0.0 ? static_cast<float>(std::clamp(m_remainingMs / m_totalMs, 0.0, 1.0)) : 0.0F;
+      m_entries[index].overlay.ring->setProgress(progress);
+      m_entries[index].overlay.ring->setSeconds(std::max(1, static_cast<int>(std::ceil(m_remainingMs / 1000.0))));
+    }
+    keepTicking = true;
+  }
+
+  if (keepTicking) {
+    if (root() != nullptr) {
+      root()->markPaintDirty();
+    }
+    PanelManager::instance().requestFrameTick();
+    PanelManager::instance().refresh();
+  }
+}
