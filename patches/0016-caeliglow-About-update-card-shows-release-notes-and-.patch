+        updateCard->addChild(ui::label({
+            .text = notes,
+            .fontSize = Style::fontSizeCaption * scale,
+            .color = colorSpecFromRole(ColorRole::OnSurface),
+            .maxWidth = 420.0F * scale,
+            .maxLines = 14,
+        }));
+      }
+      if (!ctx.updateInFlight && ctx.onInstallUpdate) {
+        updateCard->addChild(ui::button({
+            .text = "Install " + (ctx.updateVersion.empty() ? std::string("latest") : ctx.updateVersion) + " now",
+            .variant = ButtonVariant::Primary,
+            .radius = Style::scaledRadiusMd(scale),
+            .onClick = ctx.onInstallUpdate,
+        }));
+        updateCard->addChild(label(
+            "Updates the system in place: CaeliGlow is rebuilt, replaces the running version and "
+            "restarts with your settings and state kept. Watch the terminal for progress.",
+            Style::fontSizeCaption * scale, ColorRole::OnSurfaceVariant
+        ));
+      }
     } else if (!ctx.updateStatusText.empty()) {
       updateCard->addChild(label(
           ctx.updateStatusText, Style::fontSizeBody * scale,
@@ -162,25 +254,6 @@ namespace settings {
