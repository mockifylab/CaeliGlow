+
+    // Release notes arrive as GitHub markdown. They are displayed strictly as plain
+    // text: strip the cosmetic markers (heading hashes, bold/inline-code), collapse
+    // blank runs, and cap the length so the About card stays scannable. Nothing is
+    // ever parsed as markup or executed.
+    std::string sanitizeReleaseNotes(std::string_view raw) {
+      std::string text;
+      text.reserve(raw.size());
+      bool prevSpace = true;
+      for (std::size_t i = 0; i < raw.size();) {
+        const char c = raw[i];
+        if (c == '#') {  // heading markers at line start
+          while (i < raw.size() && raw[i] == '#') {
+            ++i;
+          }
+          if (i < raw.size() && raw[i] == ' ') {
+            ++i;
+          }
+          continue;
+        }
+        if (c == '\n') {
+          if (!text.empty() && text.back() == '\n') {
+            ++i;
+            continue;  // collapse consecutive blank lines
+          }
+          text.push_back('\n');
+          prevSpace = true;
+          ++i;
+          continue;
+        }
+        if (c == '*' || c == '`') {  // bold/italic/inline-code markers
+          ++i;
+          continue;
+        }
+        if ((c == ' ' || c == '\t') && prevSpace) {
+          ++i;
+          continue;  // collapse leading whitespace runs
+        }
+        text.push_back(c);
+        prevSpace = false;
+        ++i;
+      }
+      while (!text.empty() && (text.back() == '\n' || text.back() == ' ')) {
+        text.pop_back();
+      }
+      constexpr std::size_t kMaxNotesChars = 1400;
+      if (text.size() > kMaxNotesChars) {
+        std::size_t cut = text.rfind('\n', kMaxNotesChars);
+        if (cut == std::string::npos || cut < kMaxNotesChars / 2) {
+          cut = kMaxNotesChars;
+        }
+        text.resize(cut);
+        text += "\n\n(Full notes are on the GitHub release page.)";
+      }
+      return text;
+    }
   } // namespace
 
   void addSettingsCaeliGlowAbout(Flex& content, SettingsAboutContext ctx) {
@@ -149,6 +205,42 @@ namespace settings {
           "Update checks are disabled while offline mode is on.", Style::fontSizeCaption * scale,
