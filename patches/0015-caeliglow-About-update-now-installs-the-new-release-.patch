From d7f16f7eb2923f84531fbd59a01617b211ae860a Mon Sep 17 00:00:00 2001
From: CaeliGlow <caeliglow@mockifylab.local>
Date: Mon, 19 Oct 2026 15:55:36 +0500
Subject: [PATCH] caeliglow: About update now installs the new release in place

When a check finds a newer release, the About section shows an
"Install vX now" button that launches the CaeliGlow quick-install
one-liner in a terminal window. The script rebuilds and replaces the
running installation; user config and state are untouched.
---
 src/shell/settings/settings_content_about.cpp | 46 +++++++++++++++++++
 src/shell/settings/settings_content_about.h   |  5 ++
 src/shell/settings/settings_window.h          |  4 ++
 src/shell/settings/settings_window_scene.cpp  |  3 ++
 4 files changed, 58 insertions(+)

diff --git a/src/shell/settings/settings_content_about.cpp b/src/shell/settings/settings_content_about.cpp
index e970d5815..ae52ea59e 100644
--- a/src/shell/settings/settings_content_about.cpp
+++ b/src/shell/settings/settings_content_about.cpp
@@ -21,6 +21,7 @@
 #include "render/core/texture_manager.h"
 #include "shell/settings/settings_content_common.h"
 #include "shell/settings/settings_window.h"
+#include "system/terminal_launch.h"
 #include "ui/builders.h"
 #include "ui/controls/flex.h"
 #include "ui/controls/image.h"
@@ -161,6 +162,25 @@ namespace settings {
       ));
     }
 
+    // CaeliGlow: updating installs the new release over this one, in place, via the
+    // same quick-install command first used to get CaeliGlow. One explicit click.
+    if (ctx.updateAvailable && !ctx.offlineMode && !ctx.updateInFlight && ctx.onInstallUpdate) {
+      updateCard->addChild(
+          ui::button({
+              .text =
+                  "Install v" + (ctx.updateVersion.empty() ? std::string("latest") : ctx.updateVersion) + " now",
+              .variant = ButtonVariant::Primary,
+              .radius = Style::scaledRadiusMd(scale),
+              .onClick = ctx.onInstallUpdate,
+          })
+      );
+      updateCard->addChild(label(
+          "Runs the CaeliGlow quick-install in a terminal: it rebuilds and replaces the running "
+          "version in place, keeping your settings and state.",
+          Style::fontSizeCaption * scale, ColorRole::OnSurfaceVariant
+      ));
+    }
+
     // ── What CaeliGlow adds (patch summary) ──────────────────────────────────
     Flex* featureCard = addSettingsCard(*page, "What CaeliGlow adds", scale);
     const std::vector<std::string> features = {
@@ -229,6 +249,8 @@ void SettingsWindow::checkForUpdates() {
   m_aboutUpdateInFlight = true;
   m_aboutStatusText.clear();
   m_aboutUpdateError = false;
+  m_aboutUpdateAvailable = false;
+  m_aboutUpdateVersion.clear();
   requestContentRebuild();
 
   HttpRequest req;
@@ -244,10 +266,34 @@ void SettingsWindow::checkForUpdates() {
     m_aboutUpdateError =
         result.state == caeliglow::UpdateState::Error || result.state == caeliglow::UpdateState::Offline ||
         result.state == caeliglow::UpdateState::RateLimited;
+    m_aboutUpdateAvailable = result.state == caeliglow::UpdateState::UpdateAvailable;
+    m_aboutUpdateVersion = result.latestVersion;
     requestContentRebuild();
   });
 }
 
+// CaeliGlow: installing an update means installing the new release over this one,
+// in place. The same quick-install one-liner that first installed CaeliGlow is run
+// in a terminal window (visible progress, user watches it finish); the script
+// rebuilds from the tagged release and restarts the shell without touching
+// ~/.config/caeliglow or the state/cache directories.
+void SettingsWindow::installUpdate() {
+  static const std::string kInstaller =
+      "curl -fsSL https://raw.githubusercontent.com/" + std::string(caeliglow::kRepoOwner) + "/"
+      + std::string(caeliglow::kRepoName) + "/main/scripts/quick-install.sh | bash";
+
+  if (terminal_launch::launch(kInstaller)) {
+    m_aboutStatusText =
+        "Installer terminal launched for v" + (m_aboutUpdateVersion.empty() ? std::string("latest") : m_aboutUpdateVersion)
+        + ". CaeliGlow is replaced in place; your settings and state are kept.";
+    m_aboutUpdateError = false;
+  } else {
+    m_aboutStatusText = "Could not open a terminal to run the installer. Run the quick-install command manually.";
+    m_aboutUpdateError = true;
+  }
+  requestContentRebuild();
+}
+
 // ── SettingsWindow animated About logo ─────────────────────────────────────────
 // The crescent-moon mark is a bundled animated GIF. Its frames are decoded once and
 // uploaded as GPU textures, then cycled by a one-shot Timer that re-arms itself each
diff --git a/src/shell/settings/settings_content_about.h b/src/shell/settings/settings_content_about.h
index 174649d42..d63b7ea14 100644
--- a/src/shell/settings/settings_content_about.h
+++ b/src/shell/settings/settings_content_about.h
@@ -21,8 +21,13 @@ namespace settings {
     std::string updateStatusText;     // last update-check result; empty until the first check
     bool updateInFlight = false;
     bool updateIsError = false;       // render updateStatusText in the error color
+    // CaeliGlow: when the last check found a newer release, About offers an
+    // in-place install (runs the quick-install script in a terminal window).
+    bool updateAvailable = false;
+    std::string updateVersion;        // newest release tag when updateAvailable
     Flex* pageTitleRow = nullptr;
     std::function<void()> onCheckForUpdates;
+    std::function<void()> onInstallUpdate;
     // Receives the non-owning pointer to the animated logo node so SettingsWindow can
     // drive its per-frame texture updates across content rebuilds. May stay null.
     Image** logoOut = nullptr;
diff --git a/src/shell/settings/settings_window.h b/src/shell/settings/settings_window.h
index 2f14868a3..ce04f340e 100644
--- a/src/shell/settings/settings_window.h
+++ b/src/shell/settings/settings_window.h
@@ -144,6 +144,8 @@ public:
   void setHttpClient(HttpClient* http) { m_httpClient = http; }
   // CaeliGlow: run the update check and reflect the result into the About section.
   void checkForUpdates();
+  // CaeliGlow: in-place update install (quick-launches the quick-install script in a terminal).
+  void installUpdate();
   // Backs plugin-store thumbnails; trimmed when the window closes.
   void setAsyncTextureCache(AsyncTextureCache* cache) { m_asyncTextures = cache; }
   void initializeDialogPresenter(
@@ -290,6 +292,8 @@ private:
   std::string m_aboutStatusText;      // CaeliGlow: last update-check result shown in About
   bool m_aboutUpdateInFlight = false;
   bool m_aboutUpdateError = false;
+  std::string m_aboutUpdateVersion; // CaeliGlow: newest release tag when an update was found
+  bool m_aboutUpdateAvailable = false;
   // CaeliGlow: animated crescent-moon mark in the About header. Decoded GIF frames live as
   // GPU textures across content rebuilds; the Image pointer is re-attached on each rebuild.
   std::vector<TextureHandle> m_aboutLogoFrames;
diff --git a/src/shell/settings/settings_window_scene.cpp b/src/shell/settings/settings_window_scene.cpp
index 433c551d7..fd906b6e9 100644
--- a/src/shell/settings/settings_window_scene.cpp
+++ b/src/shell/settings/settings_window_scene.cpp
@@ -1221,8 +1221,11 @@ void SettingsWindow::rebuildSettingsContent() {
             .updateStatusText = m_aboutStatusText,
             .updateInFlight = m_aboutUpdateInFlight,
             .updateIsError = m_aboutUpdateError,
+            .updateAvailable = m_aboutUpdateAvailable,
+            .updateVersion = m_aboutUpdateVersion,
             .pageTitleRow = m_pageTitleRow,
             .onCheckForUpdates = [this]() { checkForUpdates(); },
+            .onInstallUpdate = [this]() { installUpdate(); },
             .logoOut = &aboutLogo,
         }
     );
-- 
