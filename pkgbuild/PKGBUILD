# Maintainer: mockifylab <https://github.com/mockifylab/CaeliGlow>
pkgname=caeliglow
pkgver=1.7.0
pkgrel=1
pkgdesc='CaeliGlow desktop shell: Noctalia 5.3.0 plus the CaeliGlow patch series, with its own config namespace'
arch=(x86_64)
url='https://github.com/mockifylab/CaeliGlow'
license=('MIT')
depends=(
  wayland libglvnd freetype2 fontconfig cairo pango harfbuzz
  libxkbcommon glib2 libsecret libsodium
  sdbus-cpp libpipewire wireplumber polkit
  pam curl libwebp libjxl libsndfile librsvg
  libqalculate libxml2 md4c tomlplusplus libical
  nlohmann-json stb jemalloc
)
makedepends=(git meson ninja gcc just pkgconf python)
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/CaeliGlow"
  git submodule update --init --recursive

  # Apply the CaeliGlow series onto the pinned Noctalia checkout. The series is
  # applied inline (not via scripts/apply-patches.sh) because in a fresh clone
  # the submodule .git entry is a gitfile, not a directory.
  cd upstream/noctalia
  git config user.name  "${GIT_AUTHOR_NAME:-caeliglow-builder}"
  git config user.email "${GIT_AUTHOR_EMAIL:-caeliglow-builder@localhost}"
  while IFS= read -r p; do
    [[ "$p" =~ ^[[:space:]]*(#|$) ]] && continue
    git am --3way "$srcdir/CaeliGlow/patches/$p"
  done < "$srcdir/CaeliGlow/patches/series"
}

build() {
  cd "$srcdir/CaeliGlow/upstream/noctalia"
  # Prefix stays /usr/local so the package can never file-conflict with the
  # distro `noctalia` package (which owns everything under /usr).
  just configure release /usr/local
  # Retry for the known CachyOS g++-16 intermittent ICE; ninja resumes.
  local attempt
  for attempt in 1 2 3 4 5; do
    just build release && return 0
    echo ">> build attempt $attempt failed (g++ ICE flake?), retrying..."
    sleep 2
  done
  return 1
}

# Release gate: a binary with an unresolved soname (e.g. an orphan-removed
# libqalculate) must never ship — it fails at login before the shell's own
# logger can report anything. makepkg runs check() after build().
check() {
  cd "$srcdir/CaeliGlow"
  CAELIGLOW_BIN="$srcdir/CaeliGlow/upstream/noctalia/build-release/noctalia" \
    ./scripts/check-runtime-deps.sh
}

package() {
  cd "$srcdir/CaeliGlow/upstream/noctalia"
  DESTDIR="$pkgdir" meson install -C build-release --no-rebuild

  # Ship the binary under the CaeliGlow name so it never shadows `noctalia`
  # on PATH; assets keep their upstream-relative layout on purpose (the
  # compiled-in resource path), which lives safely under /usr/local.
  mv "$pkgdir/usr/local/bin/noctalia" "$pkgdir/usr/local/bin/caeliglow"
  local desk="$pkgdir/usr/local/share/applications/dev.noctalia.Noctalia.desktop"
  if [[ -f "$desk" ]]; then
    sed -i -e 's|^Exec=.*|Exec=/usr/local/bin/caeliglow|' \
           -e '/^TryExec=/d' -e 's|^Name=.*|Name=CaeliGlow|' "$desk"
    mv "$desk" "$pkgdir/usr/local/share/applications/caeliglow.desktop"
  fi

  install -Dm644 "$srcdir/CaeliGlow/LICENSE" "$pkgdir/usr/share/licenses/caeliglow/LICENSE"

  # Greeter session entry: picking "CaeliGlow" marks the Hyprland session so the
  # Lua autostart launches caeliglow; every other entry keeps distro noctalia.
  mkdir -p "$pkgdir/usr/local/bin" "$pkgdir/usr/local/share/wayland-sessions"
  cat > "$pkgdir/usr/local/bin/caeliglow-session" <<'EOF'
#!/bin/sh
# CaeliGlow session launcher (invoked by the greeter's "CaeliGlow" entry).
export CAELIGLOW_SESSION=1
exec /usr/bin/start-hyprland
EOF
  chmod 755 "$pkgdir/usr/local/bin/caeliglow-session"
  cat > "$pkgdir/usr/local/share/wayland-sessions/caeliglow.desktop" <<'EOF'
[Desktop Entry]
Name=CaeliGlow
Comment=Hyprland session with the CaeliGlow shell
Exec=/usr/local/bin/caeliglow-session
Type=Application
DesktopNames=Hyprland
Keywords=tiling;wayland;compositor;caeliglow;noctalia;
EOF
  chmod 644 "$pkgdir/usr/local/share/wayland-sessions/caeliglow.desktop"
}
